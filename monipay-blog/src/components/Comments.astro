---
interface Props {
  postSlug: string;
}

const { postSlug } = Astro.props;
---

<section class="comments-section" id="comments" data-slug={postSlug}>
  <h2 class="comments-title">Discussion</h2>

  <form class="comment-form" id="comment-form">
    <input
      type="text"
      name="name"
      placeholder="Your name (optional)"
      class="comment-input"
      maxlength="100"
      autocomplete="name"
    />
    <textarea
      name="content"
      placeholder="Share your thoughts..."
      class="comment-textarea"
      required
      minlength="3"
      maxlength="2000"
      rows="3"
    ></textarea>
    <!-- Honeypot field for basic bot protection -->
    <input type="text" name="website" class="hp-field" tabindex="-1" autocomplete="off" />
    <button type="submit" class="comment-submit" id="submit-btn">
      Post Comment
    </button>
    <p class="comment-status" id="comment-status"></p>
  </form>

  <div class="comments-list" id="comments-list">
    <p class="comments-loading">Loading comments...</p>
  </div>
</section>

<script>
  import { createClient } from '@supabase/supabase-js';

  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL || '';
  const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';

  const section = document.getElementById('comments') as HTMLElement;
  const slug = section.dataset.slug || '';
  const form = document.getElementById('comment-form') as HTMLFormElement;
  const listEl = document.getElementById('comments-list') as HTMLElement;
  const statusEl = document.getElementById('comment-status') as HTMLElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  // Client-side rate limiting - 1 comment per 60 seconds
  const RATE_LIMIT_MS = 60000;
  let lastSubmit = 0;

  /**
   * Generate a simple IP-like fingerprint hash for abuse tracking.
   * This is a client-side fingerprint sent to Supabase as `ip_hash`.
   * The actual IP-based rate limiting happens server-side via Supabase RLS + functions.
   */
  async function generateFingerprint(): Promise<string> {
    const raw = [
      navigator.userAgent,
      navigator.language,
      screen.width + 'x' + screen.height,
      Intl.DateTimeFormat().resolvedOptions().timeZone,
      new Date().getTimezoneOffset().toString(),
    ].join('|');

    const encoder = new TextEncoder();
    const data = encoder.encode(raw);
    const hashBuffer = await crypto.subtle.digest('SHA-256', data);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
  }

  if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
    listEl.innerHTML = '<p class="comments-empty">Comments are not configured yet.</p>';
  } else {
    const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    async function loadComments() {
      const { data, error } = await supabase
        .from('monipay_comments')
        .select('id, post_slug, name, content, created_at')
        .eq('post_slug', slug)
        .order('created_at', { ascending: false })
        .limit(50);

      if (error) {
        listEl.innerHTML = '<p class="comments-empty">Failed to load comments.</p>';
        return;
      }

      if (!data || data.length === 0) {
        listEl.innerHTML = '<p class="comments-empty">No comments yet. Be the first!</p>';
        return;
      }

      listEl.innerHTML = data
        .map((c: any) => {
          const date = new Date(c.created_at).toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
          });
          const name = c.name || 'Anonymous';
          const content = escapeHtml(c.content);
          return `
            <div class="comment-item">
              <div class="comment-header">
                <span class="comment-name">${escapeHtml(name)}</span>
                <span class="comment-date">${date}</span>
              </div>
              <p class="comment-body">${content}</p>
            </div>
          `;
        })
        .join('');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Honeypot check - if filled, it's a bot
      const honeypot = (form.querySelector('[name="website"]') as HTMLInputElement)?.value;
      if (honeypot) {
        statusEl.textContent = 'Comment posted!';
        statusEl.className = 'comment-status success';
        form.reset();
        return;
      }

      // Client-side rate limit check
      const now = Date.now();
      if (now - lastSubmit < RATE_LIMIT_MS) {
        const remaining = Math.ceil((RATE_LIMIT_MS - (now - lastSubmit)) / 1000);
        statusEl.textContent = `Please wait ${remaining}s before commenting again.`;
        statusEl.className = 'comment-status error';
        return;
      }

      const formData = new FormData(form);
      const name = (formData.get('name') as string)?.trim() || null;
      const content = (formData.get('content') as string)?.trim();

      if (!content || content.length < 3) {
        statusEl.textContent = 'Comment must be at least 3 characters.';
        statusEl.className = 'comment-status error';
        return;
      }

      if (content.length > 2000) {
        statusEl.textContent = 'Comment must be under 2000 characters.';
        statusEl.className = 'comment-status error';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Posting...';

      // Generate fingerprint for server-side abuse tracking
      let ipHash = '';
      try {
        ipHash = await generateFingerprint();
      } catch {
        ipHash = 'unknown';
      }

      const { error } = await supabase.from('monipay_comments').insert({
        post_slug: slug,
        name,
        content,
        ip_hash: ipHash,
      });

      if (error) {
        // Handle rate limit error from server-side function
        if (error.message?.includes('rate') || error.code === '42501') {
          statusEl.textContent = 'You are commenting too fast. Please wait a minute.';
        } else {
          statusEl.textContent = 'Failed to post comment. Try again.';
        }
        statusEl.className = 'comment-status error';
      } else {
        statusEl.textContent = 'Comment posted!';
        statusEl.className = 'comment-status success';
        form.reset();
        lastSubmit = now;
        await loadComments();
      }

      submitBtn.disabled = false;
      submitBtn.textContent = 'Post Comment';

      setTimeout(() => {
        statusEl.textContent = '';
      }, 5000);
    });

    // Load comments on page load
    loadComments();
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }
</script>

<style>
  .comments-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .comments-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    width: 0;
    pointer-events: none;
  }

  .comment-input,
  .comment-textarea {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    resize: vertical;
    transition: border-color 0.2s;
  }
  .comment-input:focus,
  .comment-textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }
  .comment-input::placeholder,
  .comment-textarea::placeholder {
    color: var(--color-text-muted);
  }

  .comment-submit {
    align-self: flex-start;
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 0.6rem 1.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
    font-family: var(--font-sans);
  }
  .comment-submit:hover {
    background: var(--color-primary-hover);
  }
  .comment-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .comment-status {
    font-size: 0.8rem;
    min-height: 1.2em;
    font-weight: 500;
  }
  .comment-status.error {
    color: #ef4444;
  }
  .comment-status.success {
    color: var(--color-accent);
  }

  .comments-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .comments-empty,
  .comments-loading {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .comment-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1rem;
  }

  .comment-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .comment-name {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--color-text);
  }
  .comment-date {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }
  .comment-body {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
  }
</style>
