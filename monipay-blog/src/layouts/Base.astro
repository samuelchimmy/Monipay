---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  publishedDate?: string;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  ogType = 'website',
  publishedDate,
} = Astro.props;

const siteUrl = 'https://blog.monipay.xyz';
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const ogImg = ogImage || `${siteUrl}/og-default.png`;

import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '@fontsource/fira-code/400.css';
import '@fontsource/fira-code/500.css';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImg} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Monipay Blog" />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@monipay_xyz" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImg} />

    <!-- JSON-LD: WebSite + Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "name": "Monipay Blog",
          "url": "https://blog.monipay.xyz",
          "description": "Official blog for Monipay — smart stablecoin payments powered by AI.",
          "publisher": { "@id": "https://monipay.xyz/#organization" }
        },
        {
          "@type": "Organization",
          "@id": "https://monipay.xyz/#organization",
          "name": "Monipay",
          "url": "https://monipay.xyz",
          "logo": {
            "@type": "ImageObject",
            "url": "https://blog.monipay.xyz/logo.svg"
          },
          "sameAs": [
            "https://x.com/monipay_xyz",
            "https://github.com/Monipay"
          ]
        }
      ]
    })} />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="Monipay Blog RSS" href="/rss.xml" />

    <!-- Additional head content (structured data from child layouts) -->
    <slot name="head" />

    <!-- Theme initialization (prevents flash) -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <style is:global>
      /* ─── Dark Theme (default) ─── */
      :root,
      [data-theme="dark"] {
        --color-bg: #050507;
        --color-surface: #0c0c12;
        --color-border: #1a1a2a;
        --color-text: #f4f4f5;
        --color-text-muted: #8b8b9e;
        --color-primary: #2563EB;
        --color-primary-hover: #3b82f6;
        --color-accent: #D4A017;
        --color-accent-hover: #e6b422;
        --header-bg: rgba(5, 5, 7, 0.92);
        --font-sans: 'Plus Jakarta Sans', system-ui, sans-serif;
        --font-mono: 'Fira Code', monospace;
        --max-width: 720px;
      }

      /* ─── Light Theme ─── */
      [data-theme="light"] {
        --color-bg: #ffffff;
        --color-surface: #f5f7fa;
        --color-border: #e2e5ea;
        --color-text: #0f1419;
        --color-text-muted: #536471;
        --color-primary: #2563EB;
        --color-primary-hover: #1d4ed8;
        --color-accent: #D4A017;
        --color-accent-hover: #b8860b;
        --header-bg: rgba(255, 255, 255, 0.92);
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-sans);
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        transition: background 0.3s, color 0.3s;
      }

      a {
        color: var(--color-primary);
        text-decoration: none;
        transition: color 0.2s;
      }
      a:hover {
        color: var(--color-primary-hover);
      }

      img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
      }

      code {
        font-family: var(--font-mono);
        background: var(--color-surface);
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.875em;
      }

      pre {
        background: var(--color-surface) !important;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 1.25rem;
        overflow-x: auto;
        margin: 1.5rem 0;
      }
      pre code {
        background: none;
        padding: 0;
        font-size: 0.85rem;
      }

      .container {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      /* ─── Header ─── */
      .header {
        border-bottom: 1px solid var(--color-border);
        padding: 1rem 0;
        position: sticky;
        top: 0;
        background: var(--header-bg);
        z-index: 100;
        backdrop-filter: blur(12px);
        transition: background 0.3s, border-color 0.3s;
      }
      .header-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .header-logo {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        color: var(--color-text);
        text-decoration: none;
      }
      .header-logo img {
        height: 28px;
        width: auto;
        border-radius: 0;
        color: var(--color-text);
      }
      [data-theme="dark"] .header-logo img,
      [data-theme="dark"] .footer-logo img {
        filter: brightness(0) invert(1);
      }
      [data-theme="light"] .header-logo img,
      [data-theme="light"] .footer-logo img {
        filter: none;
      }
      .logo-wordmark {
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--color-text);
        letter-spacing: -0.02em;
      }
      .header-right {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      /* Theme Toggle */
      .theme-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-surface);
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s;
        color: var(--color-text-muted);
      }
      .theme-toggle:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
      }
      .theme-toggle svg {
        width: 18px;
        height: 18px;
      }
      /* Show/hide sun/moon based on theme */
      [data-theme="dark"] .icon-sun { display: block; }
      [data-theme="dark"] .icon-moon { display: none; }
      [data-theme="light"] .icon-sun { display: none; }
      [data-theme="light"] .icon-moon { display: block; }

      /* Launch App CTA */
      .nav-cta {
        background: var(--color-primary);
        color: #fff !important;
        padding: 0.45rem 1rem;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.8rem;
        transition: background 0.2s;
        text-decoration: none;
      }
      .nav-cta:hover {
        background: var(--color-primary-hover);
        color: #fff !important;
      }

      /* ─── Footer ─── */
      .footer {
        border-top: 1px solid var(--color-border);
        padding: 3rem 0 2rem;
        margin-top: 4rem;
        transition: border-color 0.3s;
      }
      .footer-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.25rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
      }
      .footer-logo {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        color: var(--color-text);
        text-decoration: none;
      }
      .footer-logo img {
        height: 24px;
        width: auto;
        border-radius: 0;
        opacity: 0.7;
      }
      .footer-logo .logo-wordmark {
        font-size: 0.95rem;
        opacity: 0.7;
      }
      .footer-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.5rem;
      }
      .footer-links a {
        color: var(--color-text-muted);
        font-size: 0.8rem;
        font-weight: 500;
        transition: color 0.2s;
      }
      .footer-links a:hover {
        color: var(--color-text);
      }
      .footer-copy {
        color: var(--color-text-muted);
        font-size: 0.75rem;
        text-align: center;
      }

      /* ─── Sports Promo Toast ─── */
      .sports-promo-toast {
        position: fixed;
        bottom: 1rem;
        left: 1rem;
        right: 1rem;
        z-index: 1000;
        display: none;
        opacity: 0;
        transform: translateY(30px) scale(0.95);
        transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .sports-promo-toast.show {
        display: block;
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      @media (min-width: 640px) {
        .sports-promo-toast {
          left: auto;
          right: 1.5rem;
          bottom: 1.5rem;
          max-width: 480px;
        }
      }
      .sports-promo-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 24px;
        padding: 1rem;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        text-align: left;
        transition: background 0.3s, border-color 0.3s;
      }
      [data-theme="dark"] .sports-promo-card {
        background: rgba(24, 24, 27, 0.95);
        border-color: rgba(39, 39, 42, 0.8);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
      }
      .sports-promo-close {
        position: absolute;
        top: 1.5rem;
        right: 1.5rem;
        z-index: 10;
        background: rgba(0, 0, 0, 0.6);
        border: none;
        cursor: pointer;
        color: #ffffff;
        font-size: 1.2rem;
        line-height: 1;
        width: 28px;
        height: 28px;
        border-radius: 9999px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s, transform 0.1s;
        backdrop-filter: blur(4px);
      }
      .sports-promo-close:hover {
        background: rgba(0, 0, 0, 0.8);
        transform: scale(1.05);
      }
      
      .sports-banner-container {
        position: relative;
        overflow: hidden;
        border-radius: 16px;
        border: 1px solid rgba(241, 245, 249, 0.5);
        aspect-ratio: 3 / 1;
        width: 100%;
        background: #f1f5f9;
        display: flex;
      }
      [data-theme="dark"] .sports-banner-container {
        border-color: rgba(39, 39, 42, 0.5);
        background: #27272a;
      }
      .sports-banner-img {
        width: 100%;
        height: 100%;
        object-cover: cover;
        border-radius: 16px;
        display: block;
      }

      .sports-promo-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 0 0.25rem;
      }
      .sports-promo-learn {
        flex: 0 0 auto;
        height: 44px;
        padding: 0 20px;
        border-radius: 12px;
        border: 1.5px solid #d1d6e8;
        background: transparent;
        color: #3d4460;
        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        transition: border-color 0.18s, color 0.18s, background 0.18s;
        white-space: nowrap;
        letter-spacing: -0.01em;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
      }
      .sports-promo-learn:hover {
        border-color: #0e6dec;
        color: #0e6dec !important;
        background: #f4f6ff;
      }
      [data-theme="dark"] .sports-promo-learn {
        border-color: #3f3f46;
        color: #cbd5e1;
      }
      [data-theme="dark"] .sports-promo-learn:hover {
        border-color: #0e6dec;
        color: #0e6dec !important;
        background: rgba(14, 109, 236, 0.1);
      }
      .sports-promo-btn {
        flex: 1;
        height: 44px;
        padding: 0 20px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(135deg, #0e6dec 0%, #0a4ebd 100%);
        color: #ffffff !important;
        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: opacity 0.18s, transform 0.12s, box-shadow 0.18s;
        box-shadow: 0 4px 14px rgba(14, 109, 236, 0.38);
        letter-spacing: -0.01em;
        white-space: nowrap;
        text-decoration: none;
      }
      .sports-promo-btn:hover {
        opacity: 0.93;
        box-shadow: 0 6px 20px rgba(14, 109, 236, 0.45);
        transform: translateY(-1px);
        color: #ffffff !important;
      }
      .sports-promo-btn:active, .sports-promo-learn:active {
        transform: translateY(0);
        opacity: 1;
      }
      .sports-promo-btn .icon {
        width: 18px;
        height: 18px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
    </style>
  </head>
  <body>
    <header class="header">
      <div class="header-inner">
        <a href="/" class="header-logo">
          <img src="/logo.svg" alt="Monipay" />
          <span class="logo-wordmark">Monipay</span>
        </a>
        <div class="header-right">
          <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
            <!-- Sun icon (shown in dark mode, click to switch to light) -->
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <!-- Moon icon (shown in light mode, click to switch to dark) -->
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </button>
          <a href="https://monipay.xyz" target="_blank" rel="noopener noreferrer" class="nav-cta">Launch App</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <a href="/" class="footer-logo">
          <img src="/logo.svg" alt="Monipay" />
          <span class="logo-wordmark">Monipay</span>
        </a>
        <div class="footer-links">
          <a href="https://docs.monipay.xyz" target="_blank" rel="noopener noreferrer">Docs</a>
          <a href="https://monipay.xyz/monibot" target="_blank" rel="noopener noreferrer">MoniBot</a>
          <a href="https://github.com/Monipay" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://x.com/monipay_xyz" target="_blank" rel="noopener noreferrer">X (Twitter)</a>
          <a href="https://monipay.xyz/support" target="_blank" rel="noopener noreferrer">Support</a>
        </div>
        <p class="footer-copy">&copy; {new Date().getFullYear()} Monipay. Smart stablecoin payments powered by AI.</p>
      </div>
    </footer>

    <!-- Theme toggle script -->
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function() {
        const html = document.documentElement;
        const current = html.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    </script>

    <!-- Sports Promo Toast -->
    <div class="sports-promo-toast" id="sports-promo-toast">
      <div class="sports-promo-card">
        <button class="sports-promo-close" id="sports-promo-close" aria-label="Close Announcement">&times;</button>
        
        <!-- Banner Image -->
        <div class="sports-banner-container">
          <img 
            src="/images/conditional-sports-p2p-banner.jpg" 
            alt="World Cup 2026 Conditional Sports P2P"
            class="sports-banner-img"
          />
        </div>

        <div class="sports-promo-actions">
          <a href="/introducing-conditional-sports-p2p-smart-world-cup-2026-rewards" class="sports-promo-learn">Learn More</a>
          <a href="https://twitter.com/intent/tweet?text=Hey%20%40monibot%20send%20%2410%20to%20%40jade%20if%20Germany%20wins%20Curacao%20%E2%9A%BD" target="_blank" rel="noopener noreferrer" class="sports-promo-btn">
            <span class="icon">
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                <path d="M1.5 8.5l7-7M8.5 1.5H3M8.5 1.5v5.5" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            Reward Your Followers
          </a>
        </div>
      </div>
    </div>

    <!-- Sports Promo Toast script -->
    <script is:inline>
      (function() {
        const dismissed = localStorage.getItem('monipay_wc26_promo_dismissed');
        if (!dismissed) {
          const toast = document.getElementById('sports-promo-toast');
          const closeBtn = document.getElementById('sports-promo-close');

          setTimeout(function() {
            if (toast) {
              toast.style.display = 'block';
              setTimeout(() => {
                toast.classList.add('show');
              }, 10);
            }
          }, 1500);

          if (closeBtn) {
            closeBtn.addEventListener('click', function() {
              if (toast) {
                toast.classList.remove('show');
                setTimeout(() => {
                  toast.style.display = 'none';
                }, 300);
              }
              localStorage.setItem('monipay_wc26_promo_dismissed', 'true');
            });
          }
        }
      })();
    </script>
  </body>
</html>
