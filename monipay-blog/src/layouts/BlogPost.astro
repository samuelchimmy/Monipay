---
import { Image } from 'astro:assets';
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  date: string;
  tags: string[];
  slug: string;
  cover?: string;
  ogImage?: string;
  author?: string;
}

const { title, description, date, tags, slug, cover, ogImage, author = 'Samuel Chiedozie' } = Astro.props;

const siteUrl = 'https://blog.monipay.xyz';
const canonicalUrl = `${siteUrl}/${slug}`;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base
  title={`${title} | Monipay Blog`}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage || cover}
  ogType="article"
  publishedDate={date}
>
  <!-- JSON-LD: BlogPosting structured data -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": title,
      "description": description,
      "datePublished": date,
      "dateModified": date,
      "author": {
        "@type": "Person",
        "name": author,
        "url": "https://x.com/monipay_xyz"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Monipay",
        "url": "https://monipay.xyz",
        "logo": {
          "@type": "ImageObject",
          "url": "https://blog.monipay.xyz/logo.svg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalUrl
      },
      "image": ogImage || cover || "https://blog.monipay.xyz/og-default.png",
      "url": canonicalUrl,
      "keywords": tags.join(", ")
    })} />
  </Fragment>
  <article class="container post">
    <header class="post-header">
      <a href="/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        All posts
      </a>

      <div class="post-tags">
        {tags.slice(0, 4).map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>

      <h1 class="post-title">{title}</h1>

      <div class="post-meta">
        <span class="post-author">{author}</span>
        <span class="meta-separator">&middot;</span>
        <span class="post-date">{formattedDate}</span>
      </div>
    </header>

    {cover && (
      <Image
        src={cover}
        alt={title}
        width={1100}
        height={600}
        class="post-cover"
        loading="eager"
        decoding="sync"
        fetchpriority="high"
      />
    )}

    <div class="post-content">
      <slot />
    </div>

    <footer class="post-footer">
      <div class="share-section">
        <span class="share-label">Share this article</span>
        <div class="share-buttons">
          <a
            href={`https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalUrl)}&via=monipay_xyz`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn"
            aria-label="Share on X"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            Share on X
          </a>
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn"
            aria-label="Share on LinkedIn"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
        </div>
      </div>
    </footer>
  </article>

  <style>
    .post {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.85rem;
      color: var(--color-text-muted);
      margin-bottom: 2rem;
      transition: color 0.2s;
    }
    .back-link:hover {
      color: var(--color-primary);
    }

    .post-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }
    .tag {
      background: rgba(37, 99, 235, 0.08);
      border: 1px solid rgba(37, 99, 235, 0.2);
      color: var(--color-primary);
      padding: 0.2rem 0.7rem;
      border-radius: 9999px;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.01em;
    }

    .post-title {
      font-size: clamp(1.75rem, 5vw, 2.5rem);
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 1rem;
      color: var(--color-text);
    }

    .post-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      color: var(--color-text-muted);
      margin-bottom: 2rem;
    }
    .meta-separator {
      color: var(--color-border);
    }

    .post-cover {
      width: 100%;
      border-radius: 12px;
      margin-bottom: 2.5rem;
      border: 1px solid var(--color-border);
    }

    .post-content {
      font-size: 1.05rem;
      line-height: 1.8;
    }
    .post-content :global(h2) {
      font-size: 1.5rem;
      font-weight: 700;
      margin-top: 2.5rem;
      margin-bottom: 0.75rem;
      color: var(--color-text);
    }
    .post-content :global(h3) {
      font-size: 1.25rem;
      font-weight: 600;
      margin-top: 2rem;
      margin-bottom: 0.5rem;
      color: var(--color-text);
    }
    .post-content :global(p) {
      margin-bottom: 1.25rem;
    }
    .post-content :global(ul),
    .post-content :global(ol) {
      margin-bottom: 1.25rem;
      padding-left: 1.5rem;
    }
    .post-content :global(li) {
      margin-bottom: 0.5rem;
    }
    .post-content :global(blockquote) {
      border-left: 3px solid var(--color-accent);
      padding-left: 1rem;
      margin: 1.5rem 0;
      color: var(--color-text-muted);
      font-style: italic;
    }
    .post-content :global(img) {
      margin: 1.5rem 0;
      border-radius: 8px;
      border: 1px solid var(--color-border);
    }
    .post-content :global(a) {
      color: var(--color-primary);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .post-content :global(a:hover) {
      color: var(--color-primary-hover);
    }
    .post-content :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 1.5rem 0;
      font-size: 0.9rem;
    }
    .post-content :global(th),
    .post-content :global(td) {
      border: 1px solid var(--color-border);
      padding: 0.75rem;
      text-align: left;
    }
    .post-content :global(th) {
      background: var(--color-surface);
      font-weight: 600;
    }
    .post-content :global(hr) {
      border: none;
      border-top: 1px solid var(--color-border);
      margin: 2.5rem 0;
    }
    .post-content :global(strong) {
      font-weight: 700;
      color: var(--color-text);
    }

    .post-footer {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--color-border);
    }
    .share-section {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .share-label {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .share-buttons {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .share-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      color: var(--color-text);
      padding: 0.5rem 1rem;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 500;
      transition: border-color 0.2s, color 0.2s;
    }
    .share-btn:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
    }
  </style>
</Base>
