---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

const posts = await getCollection('posts');

// Sort by date descending (newest first)
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Base
  title="Monipay Blog | Smart Stablecoin Payments Powered by AI"
  description="Official corporate blog — technical deep dives, product updates, builder notes, and ecosystem commentary from the Monipay team."
>
  <section class="hero container">
    <div class="network-pills">
      <span class="net-pill"><span class="net-dot base"></span>BASE</span>
      <span class="net-pill"><span class="net-dot bsc"></span>BSC</span>
      <span class="net-pill"><span class="net-dot solana"></span>SOLANA</span>
      <span class="net-pill"><span class="net-dot ink"></span>INK</span>
      <span class="net-pill"><span class="net-dot celo"></span>CELO</span>
      <span class="net-pill"><span class="net-dot tempo"></span>TEMPO</span>
    </div>
    <h1 class="hero-title">Gasless Commerce.<br/><span class="hero-title-accent">For Everyone.</span></h1>
    <p class="hero-subtitle">
      The gasless, non-custodial payment platform with the MoniBot AI Agent, the autonomous AI agent powering agentic commerce on social media. USDC on Base and Solana. USDT on BSC and Celo. USDT0 on Ink. αUSD on Tempo.
    </p>
  </section>

  <section class="posts-grid">
    {sortedPosts.map((post, index) => {
      const date = new Date(post.data.date).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });
      const isLCP = index === 0;
      return (
        <a href={`/${post.data.slug}`} class="post-card">
          {post.data.cover && (
            <div class="post-card-img-wrap">
              <Image
                src={post.data.cover}
                alt={post.data.title}
                width={724}
                height={380}
                loading={isLCP ? "eager" : "lazy"}
                decoding={isLCP ? "sync" : "async"}
                fetchpriority={isLCP ? "high" : "auto"}
              />
            </div>
          )}
          <div class="post-card-body">
            <div class="post-card-tags">
              {post.data.tags.slice(0, 3).map((tag) => (
                <span class="tag-pill">{tag}</span>
              ))}
            </div>
            <h2 class="post-card-title">{post.data.title}</h2>
            <p class="post-card-desc">{post.data.description}</p>
            <div class="post-card-meta">
              <span>{date}</span>
            </div>
          </div>
        </a>
      );
    })}
  </section>

  <style>
    .hero {
      text-align: center;
      padding: 3.5rem 1.25rem 2.5rem;
    }

    /* Network indicator pills */
    .network-pills {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.25rem;
      margin-bottom: 2rem;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      color: var(--color-text-muted);
    }
    .net-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .net-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }
    .net-dot.base { background: #2563EB; }
    .net-dot.bsc { background: #F0B90B; }
    .net-dot.solana { background: #DC1FFF; }
    .net-dot.ink { background: #14b8a6; }
    .net-dot.celo { background: #FCFF52; }
    .net-dot.tempo { background: #6366f1; }

    .hero-title {
      font-size: clamp(1.75rem, 5vw, 2.75rem);
      font-weight: 800;
      line-height: 1.15;
      margin-bottom: 1rem;
      color: var(--color-text);
    }
    .hero-title-accent {
      color: var(--color-text-muted);
    }
    .hero-subtitle {
      font-size: 0.95rem;
      color: var(--color-text-muted);
      max-width: 560px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* Posts Grid */
    .posts-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding: 2rem 0.75rem 4rem;
      max-width: 1100px;
      margin: 0 auto;
    }
    @media (min-width: 640px) {
      .posts-grid {
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        padding: 2rem 1.25rem 4rem;
        gap: 1.5rem;
      }
    }

    .post-card {
      display: flex;
      flex-direction: column;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 12px;
      overflow: hidden;
      transition: border-color 0.2s, transform 0.15s;
      color: inherit;
      text-decoration: none;
    }
    .post-card:hover {
      border-color: var(--color-primary);
      transform: translateY(-2px);
    }

    .post-card-img-wrap {
      aspect-ratio: 16 / 9;
      overflow: hidden;
    }
    .post-card-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 0;
    }

    .post-card-body {
      padding: 1.25rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .post-card-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      margin-bottom: 0.75rem;
    }
    .tag-pill {
      background: rgba(37, 99, 235, 0.08);
      color: var(--color-primary);
      padding: 0.15rem 0.6rem;
      border-radius: 9999px;
      font-size: 0.68rem;
      font-weight: 600;
    }

    .post-card-title {
      font-size: 1.05rem;
      font-weight: 700;
      line-height: 1.3;
      margin-bottom: 0.5rem;
      color: var(--color-text);
    }
    .post-card-desc {
      font-size: 0.85rem;
      color: var(--color-text-muted);
      line-height: 1.5;
      flex: 1;
      margin-bottom: 0.75rem;
    }
    .post-card-meta {
      font-size: 0.75rem;
      color: var(--color-text-muted);
      font-weight: 500;
    }
  </style>
</Base>
