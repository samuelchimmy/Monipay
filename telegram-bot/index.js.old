function formatRecurrenceTg(r) {
  if (!r) return null;
  if (r === 'detected') return 'Every [period] (auto-detected)';
  const match = r.match(/^(\d+)([smhdw])$/);
  if (!match) return r;
  const val = parseInt(match[1]);
  const unit = match[2];
  const units = {
    s: 'second',
    m: 'minute',
    h: 'hour',
    d: 'day',
    w: 'week'
  };
  const label = units[unit] || unit;
  return `Every ${val} ${label}${val !== 1 ? 's' : ''}`;
}

const supabase = createClient(process.env.SUPABASE_URL, process.env.SUPABASE_SERVICE_KEY, {
  realtime: { enabled: false },
});

// ============ Builder Code ============

const BUILDER_CODE = process.env.BUILDER_CODE || 'bc_qt9yxo1d';
function builderSuffix() {
  const bytes = Buffer.from(BUILDER_CODE, 'utf8');
  const padded = Buffer.alloc(32);
  bytes.copy(padded);
  return `8021${padded.toString('hex')}8021`;
}

// ============ Chain Configs ============

import { CHAIN_CONFIGS } from './shared/chains.js';

const CHAINS = Object.fromEntries(
  Object.entries(CHAIN_CONFIGS).map(([key, config]) => [
    key,
    {
      chain: config.chain,
      rpcs: config.rpcs,
      router: config.routerAddress,
      magicPayAddress: config.magicPayAddress,
      token: config.tokenAddress,
      decimals: config.decimals,
      symbol: config.symbol,
      builder: config.useBuilderCode || false,
    }
  ])
);

const rpcIndexes = Object.fromEntries(Object.keys(CHAINS).map(key => [key, 0]));

// ============ Solana Relay (via Edge Function) ============

const SOLANA_RELAY_URL = `${process.env.SUPABASE_URL}/functions/v1/relay-solana-payment`;

async function executeSolanaRelay(action, body) {
  const resp = await fetch(SOLANA_RELAY_URL, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${process.env.SUPABASE_SERVICE_KEY}`,
    },
    body: JSON.stringify({ action, ...body }),
  });
  const data = await resp.json();
  if (!resp.ok || data.error) throw new Error(data.error || `Solana relay error: ${resp.status}`);
  return data;
}

async function getSolanaBalance(address) {
  const data = await executeSolanaRelay('getBalance', { address });
  return { balance: data.balance || 0, symbol: resolveToken('solana') };
}

const routerAbi = [
  { name: 'executeP2P', type: 'function', stateMutability: 'nonpayable', inputs: [{ name: 'from', type: 'address' }, { name: 'to', type: 'address' }, { name: 'amount', type: 'uint256' }, { name: 'nonce', type: 'uint256' }, { name: 'tweetId', type: 'string' }], outputs: [{ name: '', type: 'bool' }] },
  { name: 'getNonce', type: 'function', stateMutability: 'view', inputs: [{ name: 'user', type: 'address' }], outputs: [{ name: '', type: 'uint256' }] },
  { name: 'calculateFee', type: 'function', stateMutability: 'view', inputs: [{ name: 'amount', type: 'uint256' }], outputs: [{ name: 'fee', type: 'uint256' }, { name: 'netAmount', type: 'uint256' }] },
];

function getClients(chain) {
  const c = CHAINS[chain];
  if (!c) throw new Error(`Chain config not found for: ${chain}`);
  const rpcIdx = (rpcIndexes[chain] || 0) % c.rpcs.length;
  const rpc = c.rpcs[rpcIdx];
  return {
    pub: createPublicClient({ chain: c.chain, transport: http(rpc, { retryCount: 2 }) }),
    wallet: createWalletClient({ account: privateKeyToAccount(process.env.MONIBOT_PRIVATE_KEY), chain: c.chain, transport: http(rpc, { retryCount: 2 }) }),
    config: c,
  };
}

function rotateRpc(chain) {
  const c = CHAINS[chain];
  if (!c || !c.rpcs.length) return;
  rpcIndexes[chain] = ((rpcIndexes[chain] || 0) + 1) % c.rpcs.length;
  console.log(`  🔁 RPC failover [${chain}] → ${c.rpcs[rpcIndexes[chain]]}`);
}

function isLikelyRpcTransportError(error) {
  const message = String(error?.message || error || '').toLowerCase();
  return [
    'fetch failed',
    'network error',
    'timeout',
    'timed out',
    'connection',
    'econnreset',
    'enotfound',
    'etimedout',
    'rate limit',
    'too many requests',
    '503',
    '502',
    '504',
    'returned no data', // BSC often returns no data when the node is struggling or out of sync
    'address is not a contract',
  ].some(token => message.includes(token));
}

function isContractConfigError(error) {
  const message = String(error?.message || error || '').toLowerCase();

  return [
    'contract does not have the function',
    'function selector was not recognized',
  ].some(token => message.includes(token));
}
// ============ Promo Broadcast ============

const PROMO_MESSAGE = `🏆 *June Celo Promo*

To celebrate winning the Celo Proof of Ship AI Track:

🪄 All fees on Celo are waived through June 30.
_(CasualPay users: request fee refunds via [support](https://monipay.xyz/support) with your tx hash.)_

🎁 We're also running a *$10 demo giveaway* for the first 5 communities that add MoniBot to their group.
Add @monipaybot and message us via [support](https://monipay.xyz/support) to claim.

_Promo runs June 1–30, 2026._`;

const PROMO_ID = 'june_2025_celo_zero_fee';
const PROMO_START_DATE = new Date('2026-06-01T00:00:00Z');
const PROMO_END_DATE   = new Date('2026-06-30T23:59:59Z');

function isPromoPeriod() {
  const now = new Date();
  return now >= PROMO_START_DATE && now <= PROMO_END_DATE;
}

/** Check if we already sent this promo to a specific chat */
async function hasReceivedPromo(chatId) {
  const { data } = await supabase
    .from('promo_broadcasts')
    .select('id')
    .eq('promo_id', PROMO_ID)
    .eq('chat_id', String(chatId))
    .maybeSingle();
  return !!data;
}

/** Mark a chat as having received this promo */
async function markPromoSent(chatId, chatType) {
  await supabase.from('promo_broadcasts').upsert({
    promo_id: PROMO_ID,
    chat_id: String(chatId),
    chat_type: chatType,
    sent_at: new Date().toISOString(),
  }, { onConflict: 'promo_id,chat_id' });
}

/** Send promo to a single chat with dedup */
async function sendPromoToChat(chatId, chatType = 'private') {
  if (!isPromoPeriod()) return;
  try {
    if (await hasReceivedPromo(chatId)) return;
    await bot.sendMessage(chatId, PROMO_MESSAGE, { parse_mode: 'Markdown', disable_web_page_preview: true });
    await markPromoSent(chatId, chatType);
    console.log(`[Promo] Sent to ${chatType} ${chatId}`);
  } catch (e) {
    // Bot may have been removed or chat blocked — log and skip
    console.warn(`[Promo] Failed to send to ${chatId}: ${e.message}`);
  }
}

/**
 * Blast promo to all known groups and DM users on startup.
 * Pulls distinct chat IDs from platform_commands (groups) and
 * telegram_user_cache (individual users with known telegram_id).
 * Rate-limited to avoid Telegram flood limits (30 msg/sec max).
 */
async function broadcastPromoToAll() {
  if (!isPromoPeriod()) return;
  console.log('[Promo] Starting broadcast...');

  // 1. All known groups (distinct platform_server_id from platform_commands)
  const { data: groups } = await supabase
    .from('platform_commands')
    .select('platform_server_id')
    .eq('platform', 'telegram')
    .not('platform_server_id', 'is', null)
    .order('platform_server_id');

  const groupIds = [...new Set((groups || []).map(r => r.platform_server_id))];

  // 2. All linked users with telegram_id (profiles + wallet_profiles)
  const [profilesRes, walletRes] = await Promise.all([
    supabase.from('profiles').select('telegram_id').not('telegram_id', 'is', null),
    supabase.from('wallet_profiles').select('telegram_id').not('telegram_id', 'is', null),
  ]);

  const userIds = [...new Set([
    ...(profilesRes.data || []).map(r => r.telegram_id),
    ...(walletRes.data || []).map(r => r.telegram_id),
  ])];

  console.log(`[Promo] Broadcasting to ${groupIds.length} groups and ${userIds.length} users`);

  // Send to groups first, then DMs — 200ms gap between each to respect rate limits
  for (const chatId of groupIds) {
    await sendPromoToChat(chatId, 'group');
    await new Promise(r => setTimeout(r, 200));
  }
  for (const chatId of userIds) {
    await sendPromoToChat(chatId, 'private');
    await new Promise(r => setTimeout(r, 200));
  }

  console.log('[Promo] Broadcast complete.');
}



async function cacheTelegramUser(user) {
  try {
    if (!user || user.is_bot) return;
    const { error } = await supabase.from('telegram_user_cache').upsert({
      telegram_id: String(user.id),
      username: user.username?.toLowerCase() || null,
      first_name: user.first_name || null,
      last_name: user.last_name || null,
      last_seen_at: new Date().toISOString()
    }, { onConflict: 'telegram_id' });
    if (error) console.error('[Cache] Failed to upsert user:', error.message);
  } catch (e) {
    console.error('[Cache] Exception during upsert:', e.message);
  }
}

async function isProcessed(msgId) {
  const { data } = await supabase.from('platform_commands').select('id').eq('platform', 'telegram').eq('platform_message_id', String(msgId)).maybeSingle();
  return !!data;
}

/**
 * Resolve a recipient's Telegram ID and profile status.
 * Priority: Linked Profile > Cached Username > Reply-To > Native Mention
 */
async function resolveRecipient(tag, msg) {
  const cleanTag = String(tag).replace('@', '').toLowerCase();

  // Special check: is the tag already a numeric Telegram ID?
  const isNumericId = /^\d+$/.test(cleanTag);

  let profile = isNumericId
    ? await getProfileByPlatformId('telegram', cleanTag)
    : await getProfileByMonitag(cleanTag);
  let telegramId = profile?.telegram_id || null;

  // If no Telegram ID yet, try to resolve it from context following priority
  if (!telegramId) {
    // If input is numeric ID, use it directly
    if (isNumericId) telegramId = cleanTag;

    // 2. Cached Group Activity Lookup
    if (!telegramId) {
      const { data: cached } = await supabase.from('telegram_user_cache').select('telegram_id').eq('username', cleanTag).maybeSingle();
      if (cached) telegramId = cached.telegram_id;
    }

    // 3. Reply-Based Resolution
    if (!telegramId && msg.reply_to_message && msg.reply_to_message.from) {
      const replyUser = msg.reply_to_message.from;
      if (replyUser.username?.toLowerCase() === cleanTag || String(replyUser.id) === cleanTag) {
        telegramId = String(replyUser.id);
      }
    }

    // 4. Native Telegram Mention
    if (!telegramId) {
      const mentions = extractTelegramMentions(msg);
      const nativeMention = mentions.find(m => m.username === cleanTag || m.userId === cleanTag);
      if (nativeMention && nativeMention.userId) telegramId = nativeMention.userId;
    }
  }

  // If we found a Telegram ID but didn't have a profile yet, check if there's a profile for this ID
  if (telegramId && !profile) {
    profile = await getProfileByPlatformId('telegram', telegramId);
  }

  if (profile) {
    // Determine display username
    const displayUsername = profile.pay_tag || profile.telegram_username || cleanTag;

    // If they have a wallet, we can always do CasualPay
    const activeAddress = profile.addresses ? (profile.addresses.base || profile.addresses.celo) : profile.wallet_address;
    if (activeAddress) {
      return { id: telegramId, profile, type: 'casualpay', username: displayUsername };
    }
    // No wallet? Need a Telegram ID for MagicPay
    if (telegramId) {
      return { id: telegramId, profile, type: 'magicpay', username: displayUsername };
    }
  }

  if (telegramId) {
    // If we have an ID but no profile, try to find a username from cache or msg
    let displayUsername = cleanTag;
    if (isNumericId) {
      const { data: cached } = await supabase.from('telegram_user_cache').select('username').eq('telegram_id', telegramId).maybeSingle();
      if (cached?.username) displayUsername = cached.username;
      else if (msg.reply_to_message?.from?.id.toString() === telegramId && msg.reply_to_message.from.username) {
        displayUsername = msg.reply_to_message.from.username;
      }
    }
    return { id: telegramId, profile: null, type: 'magicpay', username: displayUsername };
  }

  return { id: null, profile: null, type: 'unknown', username: cleanTag };
}

async function logCmd(msg, type, amount, recipients, chain, status, profileId) {
  await supabase.from('platform_commands').upsert({
    platform: 'telegram',
    platform_message_id: String(msg.message_id),
    platform_user_id: String(msg.from.id),
    platform_channel_id: String(msg.chat.id),
    platform_server_id: msg.chat.type !== 'private' ? String(msg.chat.id) : null,
    command_type: type,
    command_text: msg.text || '',
    parsed_amount: amount,
    parsed_recipients: recipients,
    chain,
    status,
    profile_id: profileId,
  }, { onConflict: 'platform,platform_message_id' });
}

// ============ Schedule Detection ============

const SIMPLE_SCHEDULE_IN = /\b(?:in\s+(\d+)\s*(s(?:ec(?:ond)?s?)?|m(?:in(?:ute)?s?)?|h(?:(?:ou)?rs?)?|d(?:ays?)?))\s*$/i;
// Updated pattern to support comprehensive recurring scenarios:
// - "every 1 minute 5 times" (original)
// - "every minute 5 times" (number optional, defaults to 1)
// - "every day for 5 days" (duration format)
// - "every hour for 2 hours" (same unit duration)
// - "every second", "every minute", "every hour", "every day", "every week" (word forms)
const RECURRING_PATTERN = /\bevery\s+(?:(?:(\d+)\s+)?(s(?:ec(?:ond)?s?)?|m(?:in(?:ute)?s?)?|h(?:(?:ou)?rs?)?|d(?:ays?)?|w(?:eeks?)?)|\b(second|minute|hour|day|week)s?\b)(?:\s+(?:(?:for\s+)?(\d+)\s*(?:(s(?:ec(?:ond)?s?)?|m(?:in(?:ute)?s?)?|h(?:(?:ou)?rs?)?|d(?:ays?)?|w(?:eeks?)?)|\s*times?)))?/i;

function parseSimpleScheduleFallback(text) {
  console.log(`[DEBUG] Parsing schedule: "${text}"`);
  
  // 1. Check for "in X units" (one-time)
  const inMatch = text.match(SIMPLE_SCHEDULE_IN);
  if (inMatch) {
    console.log(`[DEBUG] Matched one-time schedule: ${JSON.stringify(inMatch)}`);
    const value = parseInt(inMatch[1]);
    const unit = inMatch[2].toLowerCase();
    let ms = 0, unitLabel = '';
    if (unit.startsWith('s')) { ms = value * 1000; unitLabel = 'second'; }
    else if (unit.startsWith('m')) { ms = value * 60000; unitLabel = 'minute'; }
    else if (unit.startsWith('h')) { ms = value * 3600000; unitLabel = 'hour'; }
    else if (unit.startsWith('d')) { ms = value * 86400000; unitLabel = 'day'; }
    else return null;

    if (ms < 10000 || ms > 30 * 86400000) return null;
    const scheduledAt = new Date(Date.now() + ms);
    const commandText = text.replace(SIMPLE_SCHEDULE_IN, '').trim();
    const plural = value !== 1 ? 's' : '';
    return {
      hasSchedule: true,
      scheduledAt: scheduledAt.toISOString(),
      command: commandText.replace(/^\/(?:send|pay|monibot)\s*/i, '').replace(/^monibot\s*/i, '').trim(),
      timeDescription: `in ${value} ${unitLabel}${plural}`,
    };
  }

  // 2. Check for comprehensive recurring patterns
  const recMatch = text.match(RECURRING_PATTERN);
  console.log(`[DEBUG] Testing recurring pattern against: "${text}"`);
  console.log(`[DEBUG] Recurring match result: ${JSON.stringify(recMatch)}`);
  
  if (recMatch) {
    console.log(`[DEBUG] Matched recurring schedule: ${JSON.stringify(recMatch)}`);
    
    // Parse the match groups:
    // Group 1: number prefix (e.g., "2" in "every 2 minutes")
    // Group 2: unit abbreviation (e.g., "m" from "minute") 
    // Group 3: word-form unit (e.g., "minute" from "every minute")
    // Group 4: count/duration number (e.g., "5" from "5 times" or "for 5 days")
    // Group 5: duration unit (e.g., "d" from "for 5 days")
    
    const numberPrefix = recMatch[1] ? parseInt(recMatch[1]) : 1; // Default to 1 if omitted
    const unitAbbr = recMatch[2]; // Abbreviated unit (s, m, h, d, w)
    const unitWord = recMatch[3]; // Word unit (second, minute, hour, day, week)
    const countOrDuration = recMatch[4] ? parseInt(recMatch[4]) : null;
    const durationUnit = recMatch[5];

    // Determine the actual unit and interval value
    let intervalValue, unitChar, unitLabel;
    
    if (unitWord) {
      // Word form: "every minute", "every day"
      intervalValue = 1; // Word form implies 1 unit
      const wordToChar = { second: 's', minute: 'm', hour: 'h', day: 'd', week: 'w' };
      unitChar = wordToChar[unitWord.toLowerCase()] || 'm';
      unitLabel = unitWord;
    } else if (unitAbbr) {
      // Abbreviated form: "every 2m", "every hour"
      intervalValue = numberPrefix;
      unitChar = unitAbbr.toLowerCase()[0];
      const charToWord = { s: 'second', m: 'minute', h: 'hour', d: 'day', w: 'week' };
      unitLabel = charToWord[unitChar] || 'minute';
    } else {
      console.log(`[DEBUG] No valid unit found in recurring match`);
      return null;
    }

    console.log(`[DEBUG] Parsed interval: ${intervalValue} ${unitLabel}, count: ${countOrDuration}`);

    // Extract the base command by removing the recurring pattern
    const commandText = text
      .replace(RECURRING_PATTERN, '')
      .replace(/hi\s+/gi, '')
      .replace(/@monipaybot/gi, '')
      .replace(/@monibot/gi, '')
      .replace(/monipaybot/gi, '')
      .replace(/monibot/gi, '')
      .replace(/^\/(?:send|pay|monibot)\s*/i, '')
      .trim();

    // Calculate first run time = now + one interval (minimum 60 seconds for executor)
    const msMap = { s: 1000, m: 60000, h: 3600000, d: 86400000, w: 604800000 };
    const intervalMs = Math.max(intervalValue * msMap[unitChar], 60000); // minimum 60s
    const firstRun = new Date(Date.now() + intervalMs);

    // Determine repeat count
    let finalRepeatCount = countOrDuration;
    
    // If we have a duration unit, calculate how many intervals fit in the duration
    if (countOrDuration && durationUnit) {
      const durUnitChar = durationUnit.toLowerCase()[0];
      const durationMs = countOrDuration * msMap[durUnitChar];
      finalRepeatCount = Math.floor(durationMs / intervalMs);
      if (finalRepeatCount === 0) finalRepeatCount = 1; // At least 1
      console.log(`[DEBUG] Calculated repeat count from duration: ${finalRepeatCount}`);
    }

    const result = {
      hasSchedule: true,
      scheduledAt: firstRun.toISOString(),
      command: commandText,
      recurrence: `${intervalValue}${unitChar}`,
      repeatCount: finalRepeatCount,
      timeDescription: `every ${intervalValue > 1 ? intervalValue + ' ' : ''}${unitLabel}${intervalValue !== 1 ? 's' : ''}${finalRepeatCount ? ` for ${finalRepeatCount} times` : ''}`,
      // Executor-required fields
      isRecurring: true,
      recurrenceRule: unitLabel,
      recurrenceInterval: intervalValue,
    };

    console.log(`[DEBUG] Returning recurring schedule result: ${JSON.stringify(result)}`);
    return result;
  }

  console.log(`[DEBUG] No schedule pattern matched`);
  return null;
}

// ============ Command Parsing ============

function detectChain(text) {
  const l = text.toLowerCase();
  if (['on celo', 'celo', 'minipay'].some(k => l.includes(k))) return 'celo';
  if (['on ink', 'ink chain', 'ink network', 'inkonchain'].some(k => l.includes(k))) return 'ink';
  if (['on solana', 'solana', 'sol '].some(k => l.includes(k))) return 'solana';
  if (['on tempo', 'tempo', 'alphausd', 'αusd', 'ausd'].some(k => l.includes(k))) return 'tempo';
  if (['usdt', 'bnb', 'bsc'].some(k => l.includes(k))) return 'bsc';
  if (['on base', 'base'].some(k => l.includes(k))) return 'base';
  return null;
}

// Chains that users might mention but we don't support — map to a helpful message
const UNSUPPORTED_CHAIN_HINTS = {
  ethereum: 'Ethereum (ETH) isn\'t supported yet. Try Base (built on Ethereum) — use `on base`.',
  eth: 'Ethereum (ETH) isn\'t supported yet. Try Base — use `on base`.',
  polygon: 'Polygon isn\'t supported yet. Supported: Base, BSC, Celo, Ink, Solana.',
  matic: 'Polygon isn\'t supported yet. Supported: Base, BSC, Celo, Ink, Solana.',
  tron: 'Tron isn\'t supported. Supported: Base, BSC, Celo, Ink, Solana.',
  trx: 'Tron isn\'t supported. Supported: Base, BSC, Celo, Ink, Solana.',
  avax: 'Avalanche isn\'t supported. Supported: Base, BSC, Celo, Ink, Solana.',
  avalanche: 'Avalanche isn\'t supported. Supported: Base, BSC, Celo, Ink, Solana.',
  arbitrum: 'Arbitrum isn\'t supported yet. Try Base — use `on base`.',
  optimism: 'Optimism isn\'t supported yet. Try Base — use `on base`.',
  op: 'Optimism isn\'t supported yet. Try Base — use `on base`.',
};

function detectUnsupportedChain(text) {
  const l = text.toLowerCase();
  for (const [keyword, hint] of Object.entries(UNSUPPORTED_CHAIN_HINTS)) {
    if (l.includes(keyword)) return hint;
  }
  return null;
}

function isSolanaChain(chain) { return chain === 'solana'; }

const PREFERRED_CHAIN_ALIASES = {
  base: 'base',
  bsc: 'bsc',
  bnb: 'bsc',
  binance: 'bsc',
  celo: 'celo',
  minipay: 'celo',
  ink: 'ink',
  sol: 'solana',
  solana: 'solana',
};
const PREFERRED_CHAIN_OPTIONS = ['base', 'bsc', 'celo', 'ink', 'solana'];

function normalizePreferredChain(input) {
  const key = String(input || '').toLowerCase().replace(/[^a-z0-9]/g, '');
  return PREFERRED_CHAIN_ALIASES[key] || null;
}

function getPreferredChainChangeMatch(text) {
  const clean = String(text || '')
    .replace(/@monipaybot/gi, '')
    .replace(/@monibot/gi, '')
    .replace(/^\/change(?:@\w+)?\s*/i, '')
    .trim();

  return clean.match(/\b(?:change|set|switch|update)\s+(?:(?:my|the)\s+)?(?:(?:preferred|default)\s+)?(?:chain|network)\s*(?:to|as|=)?\s*([a-z0-9_-]+)/i)
    || clean.match(/\b(?:preferred|default)\s+(?:chain|network)\s*(?:to|as|=)?\s*([a-z0-9_-]+)/i);
}

function isPreferredChainChangeIntent(text) {
  return !!getPreferredChainChangeMatch(text);
}

function parsePreferredChainChange(text) {
  const match = getPreferredChainChangeMatch(text);
  if (!match) return null;
  return normalizePreferredChain(match[1]);
}

async function handlePreferredChainChange(msg, text) {
  const chain = parsePreferredChainChange(text);
  const isPrivate = msg.chat.type === 'private';
  if (!chain) {
    const prefix = isPrivate ? '' : '/change ';
    const dmNote = isPrivate ? '\n\n💡 *Tip:* You don\'t need the `/` prefix here!' : '';
    await bot.sendMessage(msg.chat.id, `❓ Usage: \`${prefix}preferred chain to base\`\n\nSupported defaults: ${PREFERRED_CHAIN_OPTIONS.join(', ')}${dmNote}`, { parse_mode: 'Markdown' });
    return;
  }

  const profile = await getProfileByPlatformId('telegram', msg.from.id);
  if (!profile) {
    await sendLinkRequired(msg.chat.id, ``, !isPrivate);
    return;
  }

  const { error } = await supabase
    .from('profiles')
    .update({ preferred_network: chain })
    .eq('id', profile.id);

  if (error) {
    console.error('[PreferredChain] Failed to update preferred chain:', error.message);
    await bot.sendMessage(msg.chat.id, `❌ Couldn't update your preferred chain right now. Please try again.`);
    return;
  }

  await bot.sendMessage(
    msg.chat.id,
    `✅ Preferred chain updated to *${resolveChainName(chain)}* (${resolveToken(chain)}).\n\nFuture payments without an explicit \`on <chain>\` will use ${resolveChainName(chain)} by default.`,
    { parse_mode: 'Markdown' }
  );
}

function parseP2P(text) {
  const clean = text.trim();
  const keywords = 'send|pay|tip|bless|give|dash|settle|spray|wire|gift|rizz|buss|tax|shippo|transfer|grant|reward|bless\\s+with';
  // Multi: "send $1 each to @a, @b"
  const multi = clean.match(new RegExp(`^(?:${keywords})?\\s*\\$?([\\d.]+)\\s*(?:\\w*\\s+)?each\\s+to\\s+(.*)`, 'i'));
  if (multi) {
    const tags = (multi[2].match(/@(\w[\w-]*)/g) || []).map(m => m.slice(1).toLowerCase()).filter(t => t !== 'monibot');
    if (tags.length) return { type: 'p2p_multi', amount: parseFloat(multi[1]), recipients: tags, chain: detectChain(text) };
  }
  // Single: "send $5 to @alice", "bless @alice with $5", or just "$5" (for replies)
  const single = clean.match(new RegExp(`^(?:${keywords})?\\s*(?:@(\\w[\\w-]*)\\s+)?(?:with\\s+)?\\$?([\\d.]+)(?:\\s+(?:to\\s+)?@(\\w[\\w-]*))?(?:\\s+on\\s+\\w+)?$`, 'i'));
  if (single) {
    const tag = (single[1] || single[3])?.toLowerCase();
    const amount = parseFloat(single[2]);
    if (!isNaN(amount)) {
      return { type: 'p2p', amount, recipients: tag ? [tag] : [], chain: detectChain(text) };
    }
  }
  return null;
}

// ============ Telegram Bot ============

console.log('┌─────────────────────────────────────────────────┐');
console.log('│       MoniBot Telegram Bot v2.0 (AI-Powered)    │');
console.log('│    NLP Commands + Conversational AI              │');
console.log('└─────────────────────────────────────────────────┘\n');

const bot = new TelegramBot(process.env.TELEGRAM_BOT_TOKEN, {
  polling: {
    interval: 300,
    autoStart: false,
    params: { timeout: 10 }
  }
});

// Clear webhook and start polling
(async () => {
  try {
    await bot.deleteWebHook();
    await bot.startPolling();
    console.log('✅ Telegram polling started');

    // Start polling for scheduled job results
    setInterval(() => pollScheduledJobResults(bot), 30 * 1000);

    // Blast promo to all known chats on startup (deduped — safe to run every restart)
    setTimeout(() => broadcastPromoToAll(), 5000);
  } catch (e) {
    console.error('❌ Failed to start polling:', e.message);
  }
})();

// When bot is added to a new group — send promo immediately
bot.on('my_chat_member', (update) => setImmediate(async () => {
  const { chat, new_chat_member } = update;
  if (!new_chat_member) return;
  const isAdded = ['member', 'administrator'].includes(new_chat_member.status);
  if (!isAdded) return;
  if (!['group', 'supergroup'].includes(chat.type)) return;

  console.log(`[Bot] Added to group: ${chat.title} (${chat.id})`);

  // Send welcome + promo
  try {
    await bot.sendMessage(chat.id,
      `👋 Hey! I'm *@monipaybot* — your AI-powered payment agent.\n\nSend, tip, and pay anyone in this group with stablecoins across Base, BSC, Celo, Ink, and Solana. No wallets needed to receive.\n\nType /help to get started.`,
      { parse_mode: 'Markdown' }
    );
    // Small delay then send promo separately so it stands out
    await new Promise(r => setTimeout(r, 1000));
    await sendPromoToChat(chat.id, 'group');
  } catch (e) {
    console.error(`[Bot] Failed to send welcome to ${chat.id}:`, e.message);
  }
}));

bot.on('message', (msg) => setImmediate(async () => {
  if (msg.from) await cacheTelegramUser(msg.from);
}));

const sendMainMenu = async (chatId, welcomeText = null, isPrivate = false) => {
  const prefixNote = isPrivate ? `\n\n💡 *Note:* In this DM, you don't need the \`/\` prefix. Just type what you want to do!` : '';
  const text = welcomeText || `🤖 *MoniPay Interactive Assistant*

Welcome! I'm your AI-powered financial agent. I can help you send, tip, and schedule payments across multiple blockchains using just Telegram usernames.${prefixNote}

How can I help you today? Select an option below to get started.`;

  await bot.sendMessage(chatId, text, {
    parse_mode: 'Markdown',
    reply_markup: MAIN_MENU_KEYBOARD
  });
};

// /start and /help
bot.onText(/\/(start|help)/, (msg) => setImmediate(async () => {
  await sendMainMenu(msg.chat.id, null, msg.chat.type === 'private');

  // Send promo to new DM users on /start (deduped — safe to call every time)
  if (msg.chat.type === 'private') {
    await new Promise(r => setTimeout(r, 800));
    await sendPromoToChat(msg.chat.id, 'private');
  }
}));

// /link
bot.onText(/\/link/, (msg) => setImmediate(async () => {
  const profile = await getProfileByPlatformId('telegram', msg.from.id);
  if (profile) {
    await bot.sendMessage(msg.chat.id, `✅ Your Telegram is linked to *@${profile.pay_tag}*`, { parse_mode: 'Markdown' });
    return;
  }
  await bot.sendMessage(msg.chat.id, `🔗 *Link Your MoniPay Account*

*MoniPay users:*
1️⃣ Go to [monipay.xyz](https://monipay.xyz) → Settings → MoniBot AI
2️⃣ Click *Link Telegram* and approve

*MiniPay users:*
1️⃣ Open MiniPay app → Monipay miniapp
2️⃣ Click *Link Telegram* and approve

_Once linked, you can use MoniBot anywhere!_`, {
    parse_mode: 'Markdown',
    disable_web_page_preview: true,
    reply_markup: {
      inline_keyboard: [[{ text: '📖 Learn More', callback_data: 'menu_main' }]]
    }
  });
}));

const LINK_REQUIRED_MSG = (intentHint = '', isGroup = false) => {
  const hint = intentHint ? `\n\n${intentHint}` : '';
  const groupNote = isGroup ? '\n\n_DM @monipaybot privately to set up!_' : '';
  return `🔗 *Link your account to MoniPay first, blud!* 🗿${hint}

*MoniPay users:*
1️⃣ [monipay.xyz](https://monipay.xyz) → Settings → MoniBot AI → Link Telegram

*MiniPay users:*
1️⃣ MiniPay app → Monipay miniapp → Link Telegram

*Then:* Approve a Spending Allowance in settings.${groupNote}`;
};

const sendLinkRequired = async (chatId, intentHint = '', isGroup = false) => {
  await bot.sendMessage(chatId, LINK_REQUIRED_MSG(intentHint, isGroup), {
    parse_mode: 'Markdown',
    disable_web_page_preview: true,
    reply_markup: LINK_KEYBOARD
  });
};

// /change
bot.onText(/\/change(?:\s+(.+))?/i, (msg) => setImmediate(async () => {
  await handlePreferredChainChange(msg, msg.text || '');
}));

async function handleStatusTg(msg, isPrivate = false) {
  await bot.sendChatAction(msg.chat.id, 'typing');
  const profile = await getProfileByPlatformId('telegram', msg.from.id);
  if (!profile) {
    await sendLinkRequired(msg.chat.id, '', !isPrivate);
    return;
  }

  const isMiniPay = profile.source === 'wallet_profile';
  const goatedNetworks = ['base', 'bsc', 'celo', 'ink', 'solana'];

  // Fetch balances across all goated networks
  const balancePromises = goatedNetworks.map(async (chain) => {
    try {
      const addr = profile.addresses ? profile.addresses[chain] : (chain === 'celo' ? profile.wallet_address : (chain === 'solana' ? profile.solana_address : null));
      if (!addr) return { chain, balance: 0, symbol: resolveToken(chain) };

      if (chain === 'solana') {
        const { balance, symbol } = await getSolanaBalance(addr);
        return { chain, balance, symbol };
      }

      const { pub, config } = getClients(chain);
      const raw = await pub.readContract({ address: config.token, abi: erc20Abi, functionName: 'balanceOf', args: [addr] });
      return { chain, balance: parseFloat(formatUnits(raw, config.decimals)), symbol: config.symbol };
    } catch (e) {
      return { chain, balance: 0, symbol: resolveToken(chain), error: true };
    }
  });

  const [balances, scheduledResult] = await Promise.all([
    Promise.all(balancePromises),
    supabase.from('scheduled_jobs')
      .select('id, scheduled_at, status, payload')
      .eq('source_author_id', String(msg.from.id))
      .eq('status', 'pending')
      .order('scheduled_at', { ascending: true }),
  ]);

  const pendingJobs = scheduledResult.data || [];
  const preferredChain = profile.preferred_network || 'base';

  const balLines = balances
    .map(b => {
      if (b.error) return `• ${b.chain.toUpperCase()}: ⚠️ *Error fetching*`;
      const amountStr = b.balance > 0 ? `*$${b.balance.toFixed(2)}*` : `$0.00`;
      return `• ${b.chain.toUpperCase()}: ${amountStr} ${b.symbol}`;
    })
    .join('\n');

  const chainLine = `⛓ *Preferred chain:* ${resolveChainName(preferredChain)}`;
  const sourceLine = isMiniPay ? `🔵 *Account type:* MiniPay (Celo)` : `🟢 *Account type:* MoniPay`;

  let jobsLine = '';
  const recurringJobs = pendingJobs.filter(j => j.payload?.recurrence && j.payload?.seriesId);
  const oneTimeJobs = pendingJobs.filter(j => !j.payload?.recurrence).slice(0, 3);

  if (oneTimeJobs.length > 0) {
    jobsLine += `\n\n⏰ *Upcoming One-time Payments:*\n` + oneTimeJobs.map(j => {
      const t = new Date(j.scheduled_at);
      const amt = j.payload?.command?.amount || '?';
      const rec = j.payload?.command?.recipients?.[0] || '?';
      return `• $${amt} → @${rec} at ${t.toUTCString().replace(' GMT', ' UTC')}`;
    }).join('\n');
  }

  if (recurringJobs.length > 0) {
    // Group by seriesId to show unique series
    const series = {};
    recurringJobs.forEach(j => {
      if (!series[j.payload.seriesId]) series[j.payload.seriesId] = j;
    });

    jobsLine += `\n\n🔄 *Active Recurring Series:*\n` + Object.values(series).map(j => {
      const amt = j.payload?.command?.amount || '?';
      const rec = j.payload?.command?.recipients?.[0] || '?';
      const interval = formatRecurrenceTg(j.payload.recurrence);
      return `• $${amt} each ${interval} to @${rec} (ID: \`${j.payload.seriesId.substring(0,8)}\`)`;
    }).join('\n');
  }

  const keyboard = {
    inline_keyboard: [
      [{ text: '📜 History', callback_data: 'status_history' }, { text: '🪄 Claimable', callback_data: 'status_magic' }],
      [{ text: '⚙️ Settings', callback_data: 'menu_settings' }]
    ]
  };

  await bot.sendMessage(msg.chat.id,
    `📊 *@${profile.pay_tag}'s Portfolio*\n\n${sourceLine}\n${chainLine}\n\n💰 *Assets across Goated Networks:*\n${balLines}${jobsLine}`,
    { parse_mode: 'Markdown', reply_markup: keyboard }
  );
}

// /status — quick account overview
bot.onText(/\/status/, (msg) => setImmediate(async () => {
  await handleStatusTg(msg, msg.chat.type === 'private');
}));

async function handleAuraLeaderboard(msg) {
  if (msg.chat.type === 'private') {
    await bot.sendMessage(msg.chat.id, `🏅 *Global Leaderboard* coming soon! Aura leaderboards currently work in group chats to track the Top Gs of that community.`, { parse_mode: 'Markdown' });
    return;
  }

  await bot.sendChatAction(msg.chat.id, 'typing');

  // Fetch top tippers for this group
  // Query monibot_transactions by platform_channel_id if available, or just sender profiles
  // Since we don't store channel ID in transactions directly, we'll approximate
  // by showing top tippers across the platform who have been active in this group

  const { data: topTippers, error } = await supabase
    .from('monibot_transactions')
    .select('payer_pay_tag, amount')
    .eq('status', 'completed')
    .order('amount', { ascending: false })
    .limit(50);

  if (error || !topTippers) {
    await bot.sendMessage(msg.chat.id, `❌ Couldn't fetch Aura data right now.`);
    return;
  }

  // Aggregate by tag
  const totals = topTippers.reduce((acc, curr) => {
    acc[curr.payer_pay_tag] = (acc[curr.payer_pay_tag] || 0) + curr.amount;
    return acc;
  }, {});

  const sorted = Object.entries(totals)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5);

  let text = `🦁 *${msg.chat.title} Aura Leaderboard* 🦁\n\nCheck out who has the most W Aura in the group:\n\n`;
  if (sorted.length === 0) text += `_No Aura detected yet. Start tipping to climb the ranks!_`;
  else {
    const emojis = ['👑', '🥈', '🥉', '👤', '👤'];
    text += sorted.map(([tag, total], i) => `${emojis[i]} *@${tag}*: *$${total.toFixed(2)}* Aura`).join('\n');
    text += `\n\n🔥 *Top G of the Week:* @${sorted[0][0]}`;
  }

  await bot.sendMessage(msg.chat.id, text, { parse_mode: 'Markdown' });
}

bot.onText(/\/aura/i, (msg) => setImmediate(async () => {
  await handleAuraLeaderboard(msg);
}));

bot.onText(/\/cancel(?:\s+(.+))?/i, (msg, match) => setImmediate(async () => {
  const seriesId = match[1]?.trim();
  if (!seriesId) {
    await bot.sendMessage(msg.chat.id, `❓ Usage: \`/cancel <series_id>\`\n\nYou can find your active series IDs in /status.`, { parse_mode: 'Markdown' });
    return;
  }

  const { error } = await supabase
    .from('scheduled_jobs')
    .update({ status: 'cancelled' })
    .eq('source_author_id', String(msg.from.id))
    .eq('status', 'pending')
    .or(`id.eq.${seriesId},payload->>seriesId.eq.${seriesId}`);

  if (error) {
    await bot.sendMessage(msg.chat.id, `❌ Failed to cancel. Make sure the ID is correct.`);
  } else {
    await bot.sendMessage(msg.chat.id, `✅ Cancelled any pending payments matching ID \`${seriesId}\`.`);
  }
}));

// /balance
bot.onText(/\/balance(?:\s+(.+))?/, (msg, match) => setImmediate(async () => {
  await bot.sendChatAction(msg.chat.id, 'typing');
  const profile = await getProfileByPlatformId('telegram', msg.from.id);
  if (!profile) { await sendLinkRequired(msg.chat.id, ``, msg.chat.type !== 'private'); return; }

  const requestedChain = match[1] ? detectChain(match[1]) : null;
  const chain = requestedChain || profile.preferred_network || 'base';
  
  const solAddr = profile.addresses ? profile.addresses.solana : profile.solana_address;
  if (isSolanaChain(chain) && solAddr) {
    try {
      const { balance, symbol } = await getSolanaBalance(solAddr);
      await bot.sendMessage(msg.chat.id, `💰 *${balance.toFixed(2)} ${symbol}* on ${resolveChainName(chain)}\n\n_@${profile.pay_tag}_`, { parse_mode: 'Markdown' });
    } catch (e) {
      await bot.sendMessage(msg.chat.id, `❌ Failed to fetch Solana balance: ${e.message}`);
    }
    return;
  }

  try {
    const { pub, config } = getClients(chain);
    const walletAddr = profile.addresses ? profile.addresses[chain] : profile.wallet_address;
    if (!walletAddr) {
      const dmNote = msg.chat.type === 'private' ? '\n\n💡 *Tip:* In DMs, you can just type "balance on base" without the `/`!' : '';
      await bot.sendMessage(msg.chat.id, `❌ You don't have a wallet configured for ${resolveChainName(chain)} yet.${dmNote}`, { parse_mode: 'Markdown' });
      return;
    }
    const bal = await pub.readContract({ address: config.token, abi: erc20Abi, functionName: 'balanceOf', args: [walletAddr] });

    await bot.sendMessage(msg.chat.id, `💰 *${parseFloat(formatUnits(bal, config.decimals)).toFixed(2)} ${resolveToken(chain)}* on ${resolveChainName(chain)}\n\n_@${profile.pay_tag}_`, { parse_mode: 'Markdown' });
  } catch (e) {
    await bot.sendMessage(msg.chat.id, `❌ Failed to fetch balance on ${resolveChainName(chain)}: ${e.message}`);
  }
}));

// /send or /pay
bot.onText(/\/(send|pay)(?:\s+(.+))?/i, (msg, match) => setImmediate(async () => {
  if (await isProcessed(msg.message_id)) return;

  const text = match[2] || '';

  // Typing indicator — instant feedback
  await bot.sendChatAction(msg.chat.id, 'typing');

  // Check for scheduling first (Regex priority, then AI)
  const scheduleResult = parseSimpleScheduleFallback(text) || await aiParseSchedule(text, 'telegram');
  if (scheduleResult?.hasSchedule && scheduleResult.scheduledAt && scheduleResult.command) {
    await handleScheduledCommandTg(msg, scheduleResult, text);
    return;
  }

  const cmd = parseP2P(text);
  if (!cmd) {
    // "Did you mean" guidance
    const isPrivate = msg.chat.type === 'private';
    const prefix = isPrivate ? '' : '/send ';
    const amountMatch = text.match(/\$?([\d.]+)/);
    const tagMatch = text.match(/@(\w[\w-]*)/);
    const dmNote = isPrivate ? '\n\n💡 *Tip:* You don\'t need the `/` prefix here!' : '';

    if (amountMatch && !tagMatch) {
      await bot.sendMessage(msg.chat.id, `❓ *Who are you sending to?*\n\nTry: \`${prefix}$${amountMatch[1]} to @alice\`${dmNote}`, { parse_mode: 'Markdown' });
    } else if (tagMatch && !amountMatch) {
      await bot.sendMessage(msg.chat.id, `❓ *How much do you want to send?*\n\nTry: \`${prefix}$5 to @${tagMatch[1]}\`${dmNote}`, { parse_mode: 'Markdown' });
    } else {
      await bot.sendMessage(msg.chat.id, `❓ Usage: \`${prefix}$5 to @alice\`${dmNote}`, { parse_mode: 'Markdown' });
    }
    return;
  }

  const sender = await getProfileByPlatformId('telegram', msg.from.id);
  if (!sender) {
    const hint = cmd.amount && cmd.recipients?.length ? `Looks like you're trying to send *$${cmd.amount}* to *@${cmd.recipients[0]}* — link your account first.` : '';
    await sendLinkRequired(msg.chat.id, hint, msg.chat.type !== 'private');
    return;
  }

  await logCmd(msg, cmd.type, cmd.amount, cmd.recipients, cmd.chain, 'processing', sender.id);

  // Use the shared P2P execution logic
  await executeP2PCommand(msg, cmd);
}));

// /giveaway
bot.onText(/\/giveaway\s+\$?([\d.]+)\s*(?:\w*\s+)?(?:to\s+)?(?:the\s+)?(?:first\s+)?(\d+)/i, (msg, match) => setImmediate(async () => {
  const amount = parseFloat(match[1]);
  const maxPeople = parseInt(match[2]);
  const chain = detectChain(msg.text) || 'base';
  await handleGiveawayTg(msg, amount, maxPeople, chain);
}));

// callback_query listener for interactive menus
bot.on('callback_query', (query) => setImmediate(async () => {
  if (query.data === 'menu_status') {
    await handleStatusTg({ chat: { id: query.message.chat.id }, from: query.from }, query.message.chat.type === 'private');
    await bot.answerCallbackQuery(query.id);
    return;
  }

  if (query.data === 'status_history') {
    const profile = await getProfileByPlatformId('telegram', query.from.id);
    if (!profile) return bot.answerCallbackQuery(query.id, { text: "Link required!" });

    const { data: txs } = await supabase.from('monibot_transactions')
      .select('*')
      .or(`sender_id.eq.${profile.id},receiver_id.eq.${profile.id}`)
      .order('created_at', { ascending: false })
      .limit(5);

    let text = `📜 *Recent Activity (@${profile.pay_tag})*\n\n`;
    if (!txs || txs.length === 0) text += `_No recent transactions found._`;
    else {
      text += txs.map(t => {
        const date = new Date(t.created_at).toLocaleDateString();
        const emoji = t.sender_id === profile.id ? '📤' : '📥';
        const target = t.sender_id === profile.id ? `@${t.recipient_pay_tag}` : `@${t.payer_pay_tag}`;
        return `${emoji} *$${t.amount.toFixed(2)}* to ${target} (${t.chain}) _${date}_`;
      }).join('\n');
    }
    await bot.sendMessage(query.message.chat.id, text, { parse_mode: 'Markdown' });
    await bot.answerCallbackQuery(query.id);
    return;
  }

  if (query.data === 'status_magic') {
    const profile = await getProfileByPlatformId('telegram', query.from.id);
    if (!profile) return bot.answerCallbackQuery(query.id, { text: "Link required!" });

    // In a real app, we'd query the IOU table for pending items matching this Telegram ID
    // Since I don't have the exact IOU table schema confirmed for selects, I'll provide a generic helpful message
    // but the prompt implies this should be a feature.
    // Memory mentions 'telegram_user_cache' and 'monibot_transactions'.
    // Let's check for monibot_transactions with status 'pending' (MagicPay usually stays 'completed' on chain but maybe 'pending' in DB until claimed?)
    // Actually, MagicPay in this system seems to use IOU Registry.

    await bot.sendMessage(query.message.chat.id,
      `🪄 *MagicPay Escrow Status*\n\n` +
      `Any MagicPay sent to your Telegram ID that hasn't been claimed yet will appear on [monipay.xyz](https://monipay.xyz) once you link your account.\n\n` +
      `_Feature note: Live claimable list coming in next update!_`,
      { parse_mode: 'Markdown' }
    );
    await bot.answerCallbackQuery(query.id);
    return;
  }

  if (query.data.startsWith('claim_guap_')) {
    const chain = query.data.replace('claim_guap_', '');
    const isCelo = chain.toLowerCase() === 'celo';

    let text = `🦁 *Secure the Bag, Blud!* 💸\n\nSomeone just sent you some guap via MagicPay! Here is how to claim it:\n\n`;

    if (isCelo) {
      text += `📱 *MiniPay Users:* (Recommended)\n1️⃣ Open MiniPay app\n2️⃣ Open the *Monipay* miniapp\n3️⃣ Click *Link Telegram*\n4️⃣ Claim your funds instantly!\n\n`;
      text += `🟢 *MoniPay Users:* Link your Telegram at [monipay.xyz](https://monipay.xyz) Settings.`;
    } else {
      text += `1️⃣ Go to [monipay.xyz](https://monipay.xyz)\n2️⃣ Open *Settings* → *MoniBot AI*\n3️⃣ Click *Link Telegram*\n4️⃣ Your funds will be waiting in your dashboard!`;
    }

    try {
      await bot.sendMessage(query.from.id, text, { parse_mode: 'Markdown', disable_web_page_preview: true });
      await bot.answerCallbackQuery(query.id, { text: "Check your DMs for claim instructions!" });
    } catch (e) {
      await bot.answerCallbackQuery(query.id, { text: "Please DM @monipaybot first so I can send instructions!", show_alert: true });
    }
    return;
  }

  if (query.data.startsWith('cancel_series_')) {
    const seriesId = query.data.replace('cancel_series_', '');
    const { data, error } = await supabase
      .from('scheduled_jobs')
      .update({ status: 'cancelled' })
      .eq('source_author_id', String(query.from.id))
      .eq('status', 'pending')
      .filter('payload->>seriesId', 'eq', seriesId);

    if (error) {
      await bot.answerCallbackQuery(query.id, { text: "Failed to cancel series.", show_alert: true });
    } else {
      await bot.answerCallbackQuery(query.id, { text: "Recurring series cancelled! 🚫" });
      await bot.sendMessage(query.message.chat.id, `✅ *Recurring Series Cancelled* (ID: \`${seriesId.substring(0,8)}\`). No further payments will be made for this series.`, { parse_mode: 'Markdown' });
    }
    return;
  }

  if (query.data.startsWith('set_chain_')) {
    const chain = query.data.replace('set_chain_', '');
    const profile = await getProfileByPlatformId('telegram', query.from.id);
    if (!profile) {
      await bot.answerCallbackQuery(query.id, { text: "Link your account first!", show_alert: true });
      return;
    }
    const { error } = await supabase.from('profiles').update({ preferred_network: chain }).eq('id', profile.id);
    if (error) {
      await bot.answerCallbackQuery(query.id, { text: "Update failed!", show_alert: true });
    } else {
      await bot.answerCallbackQuery(query.id, { text: `Success! Preferred chain: ${chain.toUpperCase()}` });
      // Refresh the settings menu
      await handleCallbackQuery(bot, { ...query, data: 'menu_settings' });
    }
    return;
  }

  await handleCallbackQuery(bot, query);
}));

// ============ AI-Powered Natural Language Handler ============
// Catches messages that mention @monibot or reply to bot but don't match slash commands

bot.on('message', (msg) => setImmediate(async () => {
  if (!msg.text) return;
  const text = msg.text.trim();
  
  // Skip slash commands (handled above) and bot's own messages
  if (text.startsWith('/')) return;
  if (msg.from?.is_bot) return;
  
  const isPrivate = msg.chat.type === 'private';
  const isMentioned = text.toLowerCase().includes('@monipaybot');
  const isReplyToBot = msg.reply_to_message?.from?.is_bot === true; // Check if replying to bot

  // Respond if mentioned, in private chat, or replying to bot
  if (!isMentioned && !isPrivate && !isReplyToBot) return;
  if (msg.edit_date) return;
  
  // Clean the text
  const cleaned = text.replace(/@monipaybot/gi, '').replace(/@monibot/gi, '').replace(/monipaybot/gi, '').replace(/monibot/gi, '').trim();
  if (!cleaned) return;

  if (isPreferredChainChangeIntent(cleaned)) {
    await handlePreferredChainChange(msg, cleaned);
    return;
  }
  
  // Deduplication
  if (await isProcessed(msg.message_id)) return;
  
  console.log(`[AI] NLP input from ${msg.from.username || msg.from.id}: "${cleaned.substring(0, 80)}"`);

  // Typing indicator — instant feedback
  await bot.sendChatAction(msg.chat.id, 'typing');

  // Check for unsupported chain mention before anything else
  const unsupportedHint = detectUnsupportedChain(cleaned);
  if (unsupportedHint) {
    await bot.sendMessage(msg.chat.id, `⛓ ${unsupportedHint}`, { parse_mode: 'Markdown' });
    return;
  }
  
  // Check for time-aware scheduling (Regex priority, then AI)
  const scheduleResult = parseSimpleScheduleFallback(text) || await aiParseSchedule(text, 'telegram');
  if (scheduleResult?.hasSchedule && scheduleResult.scheduledAt && scheduleResult.command) {
    await handleScheduledCommandTg(msg, scheduleResult, cleaned);
    return;
  }
  
  // Try regex first (fast path)
  const regexCmd = parseP2P(cleaned);
  if (regexCmd) {
    await executeP2PCommand(msg, regexCmd);
    return;
  }
  
  // Try AI parsing
  const aiResult = await aiParseCommand(cleaned, 'telegram');
  
  if (aiResult && aiResult.type && aiResult.type !== 'chat') {
    if (aiResult.type === 'balance') {
      const profile = await getProfileByPlatformId('telegram', msg.from.id);
      if (!profile) { await sendLinkRequired(msg.chat.id, ``, msg.chat.type !== 'private'); return; }
      const chain = detectChain(cleaned) || aiResult.chain || profile.preferred_network || 'base';

      const solAddr = profile.addresses ? profile.addresses.solana : profile.solana_address;
      if (isSolanaChain(chain) && solAddr) {
        const { balance, symbol } = await getSolanaBalance(solAddr);
        await bot.sendMessage(msg.chat.id, `💰 *${balance.toFixed(2)} ${symbol}* on ${resolveChainName(chain)}`, { parse_mode: 'Markdown' });
        return;
      }
      const { pub, config } = getClients(chain);
      const walletAddr = profile.addresses ? profile.addresses[chain] : profile.wallet_address;
      if (!walletAddr) {
        await bot.sendMessage(msg.chat.id, `❌ No wallet for ${resolveChainName(chain)}`);
        return;
      }
      const bal = await pub.readContract({ address: config.token, abi: erc20Abi, functionName: 'balanceOf', args: [walletAddr] });
      await bot.sendMessage(msg.chat.id, `💰 *${parseFloat(formatUnits(bal, config.decimals)).toFixed(2)} ${resolveToken(chain)}* on ${resolveChainName(chain)}`, { parse_mode: 'Markdown' });
      return;
    }
    
    if (aiResult.type === 'help') {
      await sendMainMenu(msg.chat.id, null, isPrivate);
      return;
    }
    
    if (aiResult.type === 'link') {
      const profile = await getProfileByPlatformId('telegram', msg.from.id);
      if (profile) {
        await bot.sendMessage(msg.chat.id, `✅ Already linked to *@${profile.pay_tag}*`, { parse_mode: 'Markdown' });
      } else {
        await bot.sendMessage(msg.chat.id, `🔗 *Link Your MoniPay Account*

*MoniPay users:*
1️⃣ [monipay.xyz](https://monipay.xyz) → Settings → MoniBot AI → Link Telegram

*MiniPay users:*
1️⃣ MiniPay app → Monipay miniapp → Link Telegram

_Once linked, you can use MoniBot anywhere!_`, {
          parse_mode: 'Markdown',
          disable_web_page_preview: true,
          reply_markup: {
            inline_keyboard: [[{ text: '📖 Learn More', callback_data: 'menu_main' }]]
          }
        });
      }
      return;
    }

    if (aiResult.type === 'status') {
      await handleStatusTg(msg, isPrivate);
      return;
    }

    if (aiResult.type === 'aura' || cleaned.toLowerCase().includes('aura') || cleaned.toLowerCase().includes('leaderboard')) {
      await handleAuraLeaderboard(msg);
      return;
    }
    
    // AI-parsed giveaway
    if (aiResult.type === 'giveaway' && aiResult.amount && aiResult.maxParticipants) {
      await handleGiveawayTg(msg, aiResult.amount, aiResult.maxParticipants, aiResult.chain || 'base');
      return;
    }
    
    if ((aiResult.type === 'p2p' || aiResult.type === 'p2p_multi') && aiResult.amount && aiResult.recipients?.length) {
      await executeP2PCommand(msg, { type: aiResult.type, amount: aiResult.amount, recipients: aiResult.recipients, chain: aiResult.chain || 'base' });
      return;
    }
  }
  
  // Conversational AI fallback
  const chatReply = await aiChat(cleaned, msg.from.username || msg.from.first_name, 'telegram');

  const helpKeywords = ['how', 'start', 'get started', 'help', 'what can you do', 'guide'];
  const isHelpIntent = helpKeywords.some(k => cleaned.toLowerCase().includes(k));

  if (isHelpIntent && isPrivate) {
    await sendMainMenu(msg.chat.id, chatReply, isPrivate);
    return;
  }

  if (chatReply && !chatReply.includes('Skibidi prompt blud') && !chatReply.includes('What in the Ohio')) {
    // In private chat, if it's a general greeting/question, always attach the menu to be helpful
    const options = { parse_mode: 'Markdown' };
    if (isPrivate) options.reply_markup = MAIN_MENU_KEYBOARD;

    await bot.sendMessage(msg.chat.id, chatReply, options);
  } else {
    // If AI gives a fallback or isn't sure, offer the interactive menu
    const fallbackText = chatReply || "I'm not quite sure how to handle that request.";
    await bot.sendMessage(msg.chat.id,
      `${fallbackText}\n\nNeed help? Explore the options below:`,
      {
        parse_mode: 'Markdown',
        reply_markup: MAIN_MENU_KEYBOARD
      }
    );
  }
}));

// ============ Shared P2P Execution ============

async function executeP2PCommand(msg, cmd) {
  const sender = await getProfileByPlatformId('telegram', msg.from.id);
  if (!sender) {
    await sendLinkRequired(msg.chat.id, ``, msg.chat.type !== 'private');
    return;
  }
  
  await logCmd(msg, cmd.type, cmd.amount, cmd.recipients, cmd.chain, 'processing', sender.id);
  
  const results = [];
  const recipients = (cmd.recipients.length === 0 && msg.reply_to_message?.from)
    ? [String(msg.reply_to_message.from.id)]
    : cmd.recipients;

  for (const tag of recipients) {
    if (tag === 'monipaybot' || tag === 'monibot') continue;
    const resolution = await resolveRecipient(tag, msg);
    const displayTag = resolution.username || tag;
    
    if (resolution.type === 'unknown') {
      results.push({ tag: displayTag, ok: false, reason: 'Not found' });
      continue;
    }

    if ((resolution.profile && resolution.profile.id === sender.id) || (resolution.id === String(msg.from.id))) {
      results.push({ tag: displayTag, ok: false, reason: 'Self-send' });
      continue;
    }

    let activeChain = cmd.chain || sender.preferred_network || 'base';
    const hasExplicitChain = Boolean(cmd.chain);
    let result;

    if (resolution.type === 'casualpay') {
      result = await attemptP2POnChain(msg, sender, resolution.profile, cmd.amount, displayTag, activeChain);
      
      if (!result.ok && (result.reason === 'Low balance' || result.reason === 'Low allowance' || (!hasExplicitChain && result.reason === 'Chain unavailable'))) {
        const required = cmd.amount / 0.99;
        const senderAddr = sender.addresses ? sender.addresses[activeChain] : sender.wallet_address;
        const alt = await findAlternateChain(senderAddr, required, activeChain, 'p2p');
        if (alt && !alt.needsAllowance) {
          const rerouteReason = result.reason === 'Chain unavailable' ? `${resolveChainName(activeChain)} is unavailable` : `insufficient funds/allowance on ${resolveChainName(activeChain)}`;
          await bot.sendMessage(msg.chat.id, `🔄 Rerouting @${tag} payment to *${alt.chain.toUpperCase()}* (${alt.balance.toFixed(2)} ${alt.symbol}) because ${rerouteReason}...`, { parse_mode: 'Markdown' });
          result = await attemptP2POnChain(msg, sender, resolution.profile, cmd.amount, displayTag, alt.chain);
          if (result.ok) result.rerouted = `${activeChain} → ${alt.chain}`;
        } else if (alt && alt.needsAllowance) {
          result = { tag, ok: false, reason: 'Reroute allowance low', chain: alt.chain, context: 'p2p' };
        }
      }
    } else {
      // MagicPay
      result = await attemptMagicPayOnChain(msg, sender, resolution.id, cmd.amount, displayTag, activeChain);

      if (!result.ok && (result.reason === 'Low balance' || result.reason === 'Low MagicPay allowance' || (!hasExplicitChain && result.reason === 'Chain unavailable'))) {
        const required = cmd.amount / 0.98;
        const senderAddr = sender.addresses ? sender.addresses[activeChain] : sender.wallet_address;
        const alt = await findAlternateChain(senderAddr, required, activeChain, 'magicpay');
        if (alt && !alt.needsAllowance) {
          const rerouteReason = result.reason === 'Chain unavailable' ? `${resolveChainName(activeChain)} is unavailable` : `insufficient funds/allowance on ${resolveChainName(activeChain)}`;
          await bot.sendMessage(msg.chat.id, `🔄 Rerouting MagicPay for @${displayTag} to *${alt.chain.toUpperCase()}* (${alt.balance.toFixed(2)} ${alt.symbol}) because ${rerouteReason}...`, { parse_mode: 'Markdown' });
          result = await attemptMagicPayOnChain(msg, sender, resolution.id, cmd.amount, displayTag, alt.chain);
          if (result.ok) result.rerouted = `${activeChain} → ${alt.chain}`;
        } else if (alt && alt.needsAllowance) {
          result = { tag, ok: false, reason: 'Reroute allowance low', chain: alt.chain, context: 'magicpay' };
        }
      }
    }
    
    results.push(result);
  }
  
  // Build reply using shared template (handles promo notes, MiniPay, reroutes)
  if (results.length === 1 && results[0].ok) {
    const r = results[0];
    const activeChainForR = r.chain || (r.rerouted ? r.rerouted.split(' → ')[1] : (cmd.chain || sender.preferred_network || 'base'));
    const chainConfig = CHAINS[activeChainForR];
    const symbol = chainConfig?.symbol || resolveToken(activeChainForR);
    const amountText = (r.netAmount || (cmd.amount - (r.fee || 0))).toFixed(2);

    const replyText = buildSuccessReply(r.isIOU ? 'magicpay' : 'p2p', {
      amount: amountText,
      symbol,
      recipient: r.tag,
      txHash: r.hash,
      chain: activeChainForR,
      fromChain: r.rerouted ? r.rerouted.split(' → ')[0] : null,
      senderSource: sender?.source || 'profile',
    });

    const options = { parse_mode: 'Markdown', disable_web_page_preview: true };
    if (r.isIOU) {
      options.reply_markup = {
        inline_keyboard: [[{ text: 'Claim My Guap 💸', callback_data: `claim_guap_${activeChainForR}` }]]
      };
    }

    await bot.sendMessage(msg.chat.id, replyText, options);
    // Follow-up with feedback prompt if eligible
    await sendFeedbackPrompt(bot, msg.chat.id, sender.id, r.hash, activeChainForR, supabase);
    return;
  }

  if (results.length > 1) {
    // Multi-recipient summary
    const successes = results.filter(r => r.ok);
    const failures = results.filter(r => !r.ok);
    let reply = successes.length ? `✅ *${successes.length} payment(s) sent!*\n` : '';
    successes.forEach(r => {
      const finalChain = r.chain || (r.rerouted ? r.rerouted.split(' → ')[1] : (cmd.chain || 'base'));
      const routeNote = r.rerouted ? ` _(routed: ${r.rerouted})_` : '';
      const symbol = resolveToken(finalChain);
      const chainName = resolveChainName(finalChain);
      const amountStr = (r.netAmount || cmd.amount).toFixed(2);
      const feeNote = r.fee ? ` (+$${r.fee.toFixed(2)} fee)` : '';
      const typeNote = r.isIOU ? ' _(MagicPay)_' : '';
      reply += `• @${r.tag}: *$${amountStr} ${symbol}* on ${chainName}${feeNote}${routeNote}${typeNote}\n`;
    });
    if (failures.length) { reply += `\n❌ *Failed:*\n`; failures.forEach(r => { reply += `• @${r.tag}: ${r.reason}\n`; }); }

    await bot.sendMessage(msg.chat.id, reply, { parse_mode: 'Markdown' });
    // Trigger feedback prompt for the first successful transaction if eligible (cooldown will handle the rest)
    if (successes.length > 0) {
      const r = successes[0];
      const activeChainForR = r.chain || (r.rerouted ? r.rerouted.split(' → ')[1] : (cmd.chain || sender.preferred_network || 'base'));
      await sendFeedbackPrompt(bot, msg.chat.id, sender.id, r.hash, activeChainForR, supabase);
    }
    return;
  }

  if (results.length === 1 && !results[0].ok) {
    const r = results[0];
    let failType = 'error_generic';
    if (r.reason === 'Low balance') failType = 'error_balance';
    else if (r.reason === 'Low allowance') failType = 'error_allowance';
    else if (r.reason === 'Low MagicPay allowance') failType = 'error_magic_allowance';
    else if (r.reason === 'Reroute allowance low') failType = 'error_reroute_allowance';
    else if (r.reason === 'Off-chain sync failed') failType = 'error_sync';
    else if (r.reason?.includes('reverted')) failType = 'error_reverted';
    else if (r.reason === 'Not found') failType = 'error_not_found';
    else if (r.reason === 'Self-send') failType = 'error_self';
    else if (r.reason === 'Network/RPC error') failType = 'error_network';
    else if (r.reason === 'Chain unavailable') failType = 'error_chain_unavailable';
    
    const requiredTotal = r.required ? r.required.toFixed(2) : cmd.amount.toFixed(2);
    const fallbacks = {
      error_balance: `💀 Blud is actually cooked. You need *$${requiredTotal}* (including fees) but your balance is too low. Fund your wallet at monipay.xyz`,
      error_allowance: `📉 L Aura. You need to set your MoniBot allowance first. Go to monipay.xyz → Settings → MoniBot AI`,
      error_magic_allowance: `🪄 MagicPay wants to go off but you haven't approved it yet. Fix: monipay.xyz → Settings → MoniBot AI → Set Allowance → MagicPay.`,
      error_reroute_allowance: `🔀 Payment rerouted to ${resolveChainName(r.chain)} (low balance on ${resolveChainName(cmd.chain || sender.preferred_network || 'base')}), but CasualPay or MagicPay spending approval is low. Go to monipay settings and increase your spending allowance.`,
      error_sync: `⚠️ Payment was successful on-chain, but I failed to sync it with our database. Please contact [support](https://monipay.xyz/support).`,
      error_reverted: `📉 Reverted on-chain. Blud hit the chain and it said nah. Check monipay.xyz settings and retry.`,
      error_not_found: `I couldn't resolve @${r.tag} on MoniPay. If you are trying to tip a non-Monipay user in this group, ask them to type "hi" in the chat, and then you can post your command again, this will allow me create an instant MagicPay for them`,
      error_self: `🪞 Stop playing with yourself, blud. You can't send money to your own account. That's zero rizz behavior.`,
      error_network: `📡 Network/RPC issue. The chain is acting mid right now. I've rotated the RPC, please try again in a few seconds.`,
      error_chain_unavailable: `⚠️ ${resolveChainName(r.chain || cmd.chain || sender.preferred_network || 'base')} payments are not available right now because the configured router contract is not responding on-chain. Try \`/change preferred chain to base\` or explicitly use \`on Base\` while BSC config is fixed.`,
      error_generic: `🤖 NPC error. Something went wrong sending to @${r.tag}: ${r.reason}. Please try again. If it keeps failing, visit [support](https://monipay.xyz/support).`,
    };

    if (failType === 'error_not_found' || failType === 'error_self' || failType === 'error_network' || failType === 'error_chain_unavailable' || failType === 'error_reroute_allowance' || failType === 'error_sync') {
      await bot.sendMessage(msg.chat.id, fallbacks[failType], { parse_mode: 'Markdown' });
    } else {
      const aiReply = await aiTransactionReply({ type: failType, sender: sender.pay_tag, recipient: r.tag, amount: cmd.amount, chain: cmd.chain });
      await bot.sendMessage(msg.chat.id, aiReply || fallbacks[failType], { parse_mode: 'Markdown' });
    }
    return;
  }

}

/**
 * Attempt a single P2P transfer on a specific chain. Returns result object.
 */
async function attemptP2POnChain(msg, sender, recipient, amount, tag, chainName, attempt = 1) {
  try {
    const { pub, wallet, config } = getClients(chainName);
    const feeRate = 0.01; // 1% for CasualPay
    // Calculate gross so net >= amount: gross = amount / (1 - feeRate)
    const grossAmount = amount / (1 - feeRate);
    // Round up to ensure recipient gets at least the requested amount
    const amountUnits = parseUnits((grossAmount + 1 / 10 ** config.decimals).toFixed(config.decimals), config.decimals);

    const senderAddr = sender.addresses ? sender.addresses[chainName] : sender.wallet_address;
    const recipientAddr = recipient.addresses ? recipient.addresses[chainName] : recipient.wallet_address;

    const res = await Promise.all([
      pub.readContract({ address: config.router, abi: routerAbi, functionName: 'getNonce', args: [senderAddr] }),
      pub.readContract({ address: config.token, abi: erc20Abi, functionName: 'balanceOf', args: [senderAddr] }),
      pub.readContract({ address: config.token, abi: erc20Abi, functionName: 'allowance', args: [senderAddr, config.router] }),
    ]).catch(async (err) => {
      if (isLikelyRpcTransportError(err) && attempt < 3) {
        rotateRpc(chainName);
        return null; // Signal retry
      }
      throw err;
    });

    if (res === null && attempt < 3) return attemptP2POnChain(msg, sender, recipient, amount, tag, chainName, attempt + 1);
    const [nonce, balance, allowance] = res;
    
    if (balance < amountUnits) return { tag, ok: false, reason: 'Low balance', required: grossAmount };
    if (allowance < amountUnits) return { tag, ok: false, reason: 'Low allowance', required: grossAmount };
    
    let calldata = encodeFunctionData({ abi: routerAbi, functionName: 'executeP2P', args: [senderAddr, recipientAddr, amountUnits, nonce, `tg_${msg.message_id}_${tag}`] });
    if (config.builder) calldata = `${calldata}${builderSuffix()}`;
    
    const gas = await pub.estimateContractGas({ address: config.router, abi: routerAbi, functionName: 'executeP2P', args: [senderAddr, recipientAddr, amountUnits, nonce, `tg_${msg.message_id}_${tag}`], account: wallet.account?.address });
    const hash = await wallet.sendTransaction({
      to: config.router,
      data: calldata,
      gas: gas + (gas * 20n / 100n),
    });
    const receipt = await pub.waitForTransactionReceipt({ hash });
    if (receipt.status === 'reverted') return { tag, ok: false, reason: 'Transaction reverted on-chain' };
    
    const [fee] = await pub.readContract({ address: config.router, abi: routerAbi, functionName: 'calculateFee', args: [amountUnits] });
    const feeNum = parseFloat(formatUnits(fee, config.decimals));
    const netAmount = parseFloat(formatUnits(amountUnits - fee, config.decimals));
    
    await supabase.from('monibot_transactions').insert({
      sender_id: sender.id, receiver_id: recipient.id,
      amount: netAmount, fee: feeNum, tx_hash: hash,
      type: 'p2p_command', payer_pay_tag: sender.pay_tag, recipient_pay_tag: recipient.pay_tag,
      chain: chainName.toUpperCase(), status: 'completed', replied: true,
    });
    
    return { tag, ok: true, hash, fee: feeNum, netAmount, chain: chainName };
  } catch (e) {
    if (isLikelyRpcTransportError(e) && attempt < 3) {
      rotateRpc(chainName);
      return attemptP2POnChain(msg, sender, recipient, amount, tag, chainName, attempt + 1);
    }
    console.error(`[P2P] Error on ${chainName}:`, e.message);
    let reason = e.message.split(':')[0];
    if (isContractConfigError(e)) reason = 'Chain unavailable';
    else if (reason.includes('fetch') || reason.includes('RPC')) reason = 'Network/RPC error';
    return { tag, ok: false, reason, chain: chainName };
  }
}

/**
 * Attempt a MagicPay transfer on a specific chain.
 */
async function attemptMagicPayOnChain(msg, sender, recipientId, amount, tag, chainName, attempt = 1) {
  try {
    const chainConfig = getChainConfig(chainName);
    const feeRate = 0.02; // 2% for MagicPay
    const grossAmount = amount / (1 - feeRate);

    const { pub } = getClients(chainName);
    const amtUnits = parseUnits(grossAmount.toFixed(chainConfig.decimals), chainConfig.decimals);
    const senderAddr = sender.addresses ? sender.addresses[chainName] : sender.wallet_address;
    const balance = await pub.readContract({
      address: chainConfig.tokenAddress,
      abi: erc20Abi,
      functionName: 'balanceOf',
      args: [senderAddr],
    }).catch(async (err) => {
      if (isLikelyRpcTransportError(err) && attempt < 3) {
        rotateRpc(chainName);
        return null;
      }
      throw err;
    });

    if (balance === null && attempt < 3) return attemptMagicPayOnChain(msg, sender, recipientId, amount, tag, chainName, attempt + 1);

    if (balance < amtUnits) return { tag, ok: false, reason: 'Low balance', required: grossAmount };

    const onchain = await executeCreateIOU({
      chain: chainName,
      fromAddress: senderAddr,
      amount: grossAmount,
      platform: 'telegram',
      platformUserId: recipientId,
    });

    const iou = await createIOURecord({
      senderProfileId: sender.id,
      senderPayTag: sender.pay_tag,
      recipientUsername: tag,
      platform: 'telegram',
      platformUserId: recipientId,
      amount: onchain.netAmount,
      chain: chainName,
      token: chainConfig?.tokenAddress,
      tokenSymbol: chainConfig?.symbol || resolveToken(chainName),
      txHash: onchain.txHash,
      iouId: onchain.iouId,
    });

    if (!iou) return { tag, ok: false, reason: 'Off-chain sync failed' };

    const fee = grossAmount - onchain.netAmount;
    return { tag, ok: true, isIOU: true, hash: onchain.txHash, iouId: onchain.iouId, netAmount: onchain.netAmount, fee, chain: chainName };
  } catch (e) {
    if (isLikelyRpcTransportError(e) && attempt < 3) {
      rotateRpc(chainName);
      return attemptMagicPayOnChain(msg, sender, recipientId, amount, tag, chainName, attempt + 1);
    }
    console.error(`[MagicPay] Error on ${chainName}:`, e.message);
    const errMsg = e?.message || 'Unknown error';
    let reason = errMsg.startsWith('ERROR_MAGIC_PAY_ALLOWANCE') ? 'Low MagicPay allowance' :
                 errMsg.startsWith('ERROR_MAGIC_PAY_BALANCE') ? 'Low balance' :
                 errMsg.split(':')[0];
    if (isContractConfigError(e)) reason = 'Chain unavailable';
    else if (reason.includes('fetch') || reason.includes('RPC')) reason = 'Network/RPC error';
    return { tag, ok: false, reason, chain: chainName };
  }
}

// ============ AI-Parsed Giveaway for Telegram ============

async function handleGiveawayTg(msg, amount, maxPeople, chain) {
  const sender = await getProfileByPlatformId('telegram', msg.from.id);
  if (!sender) { await sendLinkRequired(msg.chat.id, ``, msg.chat.type !== 'private'); return; }

  await bot.sendMessage(msg.chat.id, `🎁 *Giveaway by @${sender.pay_tag}!*\n\n💰 *$${amount}* each to the first *${maxPeople}* people!\n\n👇 Drop your @MoniTag below to claim!`, { parse_mode: 'Markdown' });

  let claimed = 0;
  const claimedUsers = new Set();

  const handler = (reply) => setImmediate(async () => {
    if (reply.chat.id !== msg.chat.id || claimed >= maxPeople) return;
    if (reply.from.bot || claimedUsers.has(reply.from.id)) return;

    const tagMatch = reply.text?.match(/@(\w[\w-]*)/);
    if (!tagMatch) return;
    const claimTag = tagMatch[1].toLowerCase();
    if (claimTag === 'monibot') return;

    const recipient = await getProfileByMonitag(claimTag);
    if (!recipient || recipient.id === sender.id) return;

    claimedUsers.add(reply.from.id);
    claimed++;

    try {
      let { pub, wallet, config } = getClients(chain);
      const feeRate = 0.01; // 1% for CasualPay
      const grossAmount = amount / (1 - feeRate);
      const amtUnits = parseUnits((grossAmount + 1 / 10 ** config.decimals).toFixed(config.decimals), config.decimals);

      let nonce, bal, allow;
      let attempt = 0;
      while (attempt < 3) {
        try {
          const senderAddr = sender.addresses ? sender.addresses[chain] : sender.wallet_address;
          [nonce, bal, allow] = await Promise.all([
            pub.readContract({ address: config.router, abi: routerAbi, functionName: 'getNonce', args: [senderAddr] }),
            pub.readContract({ address: config.token, abi: erc20Abi, functionName: 'balanceOf', args: [senderAddr] }),
            pub.readContract({ address: config.token, abi: erc20Abi, functionName: 'allowance', args: [senderAddr, config.router] }),
          ]);
          break;
        } catch (err) {
          attempt++;
          if (isLikelyRpcTransportError(err) && attempt < 3) {
            rotateRpc(chain);
            ({ pub, wallet, config } = getClients(chain));
            continue;
          }
          throw err;
        }
      }

      if (bal < amtUnits || allow < amtUnits) {
        await bot.sendMessage(msg.chat.id, '❌ Giveaway ended — insufficient funds.');
        bot.removeListener('message', handler);
        return;
      }

      const senderAddr = sender.addresses ? sender.addresses[chain] : sender.wallet_address;
      const recipientAddr = recipient.addresses ? recipient.addresses[chain] : recipient.wallet_address;

      let cd = encodeFunctionData({ abi: routerAbi, functionName: 'executeP2P', args: [senderAddr, recipientAddr, amtUnits, nonce, `tg_giveaway_${msg.message_id}_${claimed}`] });
      if (config.builder) cd = `${cd}${builderSuffix()}`;

      const gas = await pub.estimateContractGas({ address: config.router, abi: routerAbi, functionName: 'executeP2P', args: [senderAddr, recipientAddr, amtUnits, nonce, `tg_giveaway_${msg.message_id}_${claimed}`], account: wallet.account?.address });
      const hash = await wallet.sendTransaction({ to: config.router, data: cd, gas: gas + gas / 5n });
      const receipt = await pub.waitForTransactionReceipt({ hash });
      if (receipt.status === 'reverted') {
        claimedUsers.delete(reply.from.id);
        claimed--;
        await bot.sendMessage(msg.chat.id, `Transaction for @${recipient.pay_tag} was reverted. Skipping.`);
        return;
      }

      const [fee] = await pub.readContract({ address: config.router, abi: routerAbi, functionName: 'calculateFee', args: [amtUnits] });
      const feeNum = parseFloat(formatUnits(fee, config.decimals));
      const netAmount = parseFloat(formatUnits(amtUnits - fee, config.decimals));

      await supabase.from('monibot_transactions').insert({
        sender_id: sender.id, receiver_id: recipient.id,
        amount: netAmount, fee: feeNum, tx_hash: hash,
        type: 'p2p_command', payer_pay_tag: sender.pay_tag, recipient_pay_tag: recipient.pay_tag,
        chain: chain.toUpperCase(), status: 'completed', replied: true,
      });

      await bot.sendMessage(msg.chat.id, `✅ *$${netAmount.toFixed(2)}* sent to *@${recipient.pay_tag}*! (+ $${feeNum.toFixed(2)} fee) (${claimed}/${maxPeople})`, { parse_mode: 'Markdown' });

      // Prompt sender for feedback after the first successful distribution in this giveaway
      if (claimed === 1) {
        await sendFeedbackPrompt(bot, msg.chat.id, sender.id, hash, chain, supabase);
      }

      if (claimed >= maxPeople) {
        await bot.sendMessage(msg.chat.id, '🎁 *Giveaway complete!* All spots filled.', { parse_mode: 'Markdown' });
        bot.removeListener('message', handler);
      }
    } catch (e) {
      claimedUsers.delete(reply.from.id);
      claimed--;
      console.error('Giveaway error:', e.message);
    }
  });

  bot.on('message', handler);
  setTimeout(() => { bot.removeListener('message', handler); }, 600000);
}

// ============ Scheduled Command Handler ============

async function handleScheduledCommandTg(msg, scheduleResult, originalText) {
  const sender = await getProfileByPlatformId('telegram', msg.from.id);
  if (!sender) { await sendLinkRequired(msg.chat.id, ``, msg.chat.type !== 'private'); return; }

  const scheduledAt = new Date(scheduleResult.scheduledAt);
  if (scheduledAt <= new Date()) {
    await bot.sendMessage(msg.chat.id, '⏰ That time is in the past. Please specify a future time.');
    return;
  }

  // Sanitize the command to remove scheduling keywords that confuse sub-parsers
  const cleanCommand = scheduleResult.command
    .replace(/\bevery\s+\d+\s*\w+\b/gi, '')
    .replace(/\b\d+\s*times\b/gi, '')
    .replace(/\bfor\s+\d+\s*\w+\b/gi, '')
    .replace(/\bin\s+\d+\s*\w+\b/gi, '')
    .replace(/\bat\s+\d{1,2}(?::\d{2})?\s*(?:am|pm)?\b/gi, '')
    .trim();

  // Parse the underlying command
  const innerCmd = parseP2P(cleanCommand);
  let aiCmd = null;
  if (!innerCmd) {
    const aiResult = await aiParseCommand(cleanCommand, 'telegram');
    if (aiResult && aiResult.type && aiResult.type !== 'chat' && aiResult.type !== 'help' && aiResult.type !== 'link' && aiResult.type !== 'balance') {
      aiCmd = aiResult;
    }
  }

  const cmd = innerCmd || aiCmd;
  if (!cmd) {
    await bot.sendMessage(msg.chat.id, '❌ I can only schedule payment commands. Try: `monibot send $5 to @alice tomorrow at 3pm`', { parse_mode: 'Markdown' });
    return;
  }

  // Handle rerouting for low balance if it's a recurring payment
  const isRecurring = originalText.toLowerCase().includes('every') || scheduleResult.recurrence;
  const isMiniPay = sender.source === 'wallet_profile';
  let activeChain = cmd.chain || sender.preferred_network || 'base';

  if (isRecurring && !isMiniPay) {
    try {
      const { pub, config } = getClients(activeChain);
      const senderAddr = sender.addresses ? sender.addresses[activeChain] : sender.wallet_address;

      const balance = await pub.readContract({
        address: config.token,
        abi: erc20Abi,
        functionName: 'balanceOf',
        args: [senderAddr],
      });
      const balNum = parseFloat(formatUnits(balance, config.decimals));

      if (balNum < cmd.amount) {
        const alt = await findAlternateChain(senderAddr, cmd.amount, activeChain, 'p2p');
        if (alt && !alt.needsAllowance) {
          await bot.sendMessage(msg.chat.id, `🔄 Rerouting recurring payment to *${alt.chain.toUpperCase()}* (${alt.balance.toFixed(2)} ${alt.symbol}) due to low balance on ${resolveChainName(activeChain)}...`, { parse_mode: 'Markdown' });
          activeChain = alt.chain;
          cmd.chain = alt.chain;
        }
      }
    } catch (e) {
      console.warn(`[Schedule Reroute] Failed to check balance/reroute: ${e.message}`);
    }
  } else if (isRecurring && isMiniPay) {
    // MiniPay users are locked to Celo
    activeChain = 'celo';
    cmd.chain = 'celo';
  }

  const recurrence = scheduleResult.recurrence || (originalText.toLowerCase().includes('every') ? 'detected' : null);
  const repeatCount = scheduleResult.repeatCount || null;
  const duration = scheduleResult.duration || null;

  // If recurrence detected but no limit, ask the user
  if (recurrence && !repeatCount && !duration && recurrence !== 'detected') {
    await bot.sendMessage(msg.chat.id,
      `🔄 *Recurring Payment Detected!*\n\nYou've set a recurring payment interval (${formatRecurrenceTg(recurrence)}), but I don't know how many times to repeat it.\n\n` +
      `Please reply with something like:\n• "repeat 10 times"\n• "for 2 hours"\n• "until tomorrow"`,
      { parse_mode: 'Markdown' }
    );
    return;
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // RECURRING PAYMENT: Pre-create all jobs as separate scheduled payments
  // ═══════════════════════════════════════════════════════════════════════════
  if (recurrence && recurrence !== 'detected' && repeatCount) {
    const match = recurrence.match(/^(\d+)([smhdw])$/);
    if (!match) {
      await bot.sendMessage(msg.chat.id, '❌ Invalid recurrence format. Try: `every 1 minute 5 times`', { parse_mode: 'Markdown' });
      return;
    }

    const val = parseInt(match[1]);
    const unit = match[2];
    const msMap = { s: 1000, m: 60000, h: 3600000, d: 86400000, w: 604800000 };
    const intervalMs = val * msMap[unit];

    // Limit to prevent abuse
    const MAX_RECURRING_JOBS = 100;
    if (repeatCount > MAX_RECURRING_JOBS) {
      await bot.sendMessage(msg.chat.id, `❌ Maximum ${MAX_RECURRING_JOBS} recurring payments allowed per series.`, { parse_mode: 'Markdown' });
      return;
    }

    // Generate unique series ID
    const seriesId = crypto.randomUUID?.() || Math.random().toString(36).substring(2);
    
    // Calculate total amount and validate balance
    const totalAmount = cmd.amount * repeatCount;
    const firstRunTime = scheduledAt;
    const lastRunTime = new Date(scheduledAt.getTime() + (repeatCount - 1) * intervalMs);

    // Create all jobs
    const jobs = [];
    for (let i = 0; i < repeatCount; i++) {
      const runTime = new Date(scheduledAt.getTime() + i * intervalMs);
      jobs.push({
        type: cmd.type === 'giveaway' ? 'scheduled_giveaway' : 'scheduled_p2p',
        scheduled_at: runTime.toISOString(),
        payload: {
          platform: 'telegram',
          chatId: msg.chat.id,
          senderId: sender.id,
          senderPlatformId: String(msg.from.id),
          senderSource: sender.source || 'profile',
          senderPayTag: sender.pay_tag,
          senderWallet: sender.addresses ? (sender.addresses.base || sender.addresses.celo) : sender.wallet_address,
          command: cmd,
          originalText,
          seriesId: seriesId,
          seriesIndex: i + 1,
          seriesTotalCount: repeatCount,
        },
        status: 'pending',
        source_author_id: String(msg.from.id),
        source_author_username: msg.from.username || msg.from.first_name,
        source_tweet_id: String(msg.message_id),
      });
    }

    const { data: createdJobs, error: insertError } = await supabase
      .from('scheduled_jobs')
      .insert(jobs)
      .select();

    if (insertError) {
      console.error('❌ Failed to create recurring jobs:', insertError.message);
      await bot.sendMessage(msg.chat.id, '❌ Failed to schedule recurring payments. Please try again.', { parse_mode: 'Markdown' });
      return;
    }

    console.log(`✅ Created ${createdJobs.length} recurring payment jobs (series: ${seriesId})`);

    // Send confirmation
    const summary = `⏰ *Recurring Payment Scheduled!* 🔄\n\n` +
                    `📋 *Command:* ${cleanCommand.replace(/^\/(?:send|pay|monibot)\s*/i, '').trim()}\n` +
                    `🚀 *First Payment:* ${firstRunTime.toUTCString().replace(' GMT', ' UTC')}\n` +
                    `⏱️ *Last Payment:* ${lastRunTime.toUTCString().replace(' GMT', ' UTC')}\n` +
                    `🔄 *Interval:* ${formatRecurrenceTg(recurrence)}\n` +
                    `🔢 *Total Payments:* ${repeatCount}\n` +
                    `💰 *Amount Each:* $${cmd.amount.toFixed(2)}\n` +
                    `💵 *Total Amount:* $${totalAmount.toFixed(2)}\n\n` +
                    `✅ *Status:* ${createdJobs.length} jobs queued\n` +
                    `_Series ID: ${seriesId}_`;

    const keyboard = {
      inline_keyboard: [[{ text: '🚫 Cancel All', callback_data: `cancel_series_${seriesId}` }]]
    };

    await bot.sendMessage(msg.chat.id, summary, { parse_mode: 'Markdown', reply_markup: keyboard });
    return;
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // ONE-TIME SCHEDULED PAYMENT (non-recurring)
  // ═══════════════════════════════════════════════════════════════════════════
          command: cmd,
          originalText,
          seriesId: seriesId,
          seriesIndex: i + 1,
          seriesTotalCount: repeatCount,
        },
        status: 'pending',
        source_author_id: String(msg.from.id),
        source_author_username: msg.from.username || msg.from.first_name,
        source_tweet_id: String(msg.message_id),
      });
    }

    const { data: createdJobs, error: insertError } = await supabase
      .from('scheduled_jobs')
      .insert(jobs)
      .select();

    if (insertError) {
      console.error('❌ Failed to create recurring jobs:', insertError.message);
      await bot.sendMessage(msg.chat.id, '❌ Failed to schedule recurring payments. Please try again.', { parse_mode: 'Markdown' });
      return;
    }

    console.log(`✅ Created ${createdJobs.length} recurring payment jobs (series: ${seriesId})`);

    // Send confirmation
    const summary = `⏰ *Recurring Payment Scheduled!* 🔄\n\n` +
                    `📋 *Command:* ${cleanCommand.replace(/^\/(?:send|pay|monibot)\s*/i, '').trim()}\n` +
                    `🚀 *First Payment:* ${firstRunTime.toUTCString().replace(' GMT', ' UTC')}\n` +
                    `⏱️ *Last Payment:* ${lastRunTime.toUTCString().replace(' GMT', ' UTC')}\n` +
                    `🔄 *Interval:* ${formatRecurrenceTg(recurrence)}\n` +
                    `🔢 *Total Payments:* ${repeatCount}\n` +
                    `💰 *Amount Each:* $${cmd.amount.toFixed(2)}\n` +
                    `💵 *Total Amount:* $${totalAmount.toFixed(2)}\n\n` +
                    `✅ *Status:* ${createdJobs.length} jobs queued\n` +
                    `_Series ID: ${seriesId}_`;

    const keyboard = {
      inline_keyboard: [[{ text: '🚫 Cancel All', callback_data: `cancel_series_${seriesId}` }]]
    };

    await bot.sendMessage(msg.chat.id, summary, { parse_mode: 'Markdown', reply_markup: keyboard });
    return;
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // ONE-TIME SCHEDULED PAYMENT (non-recurring)
  // ═══════════════════════════════════════════════════════════════════════════
  const { data: job, error } = await supabase.from('scheduled_jobs').insert({
    type: cmd.type === 'giveaway' ? 'scheduled_giveaway' : 'scheduled_p2p',
    scheduled_at: scheduledAt.toISOString(),
    payload: {
      platform: 'telegram',
      chatId: msg.chat.id,
      senderId: sender.id,
      senderPlatformId: String(msg.from.id),
      senderSource: sender.source || 'profile',
      senderPayTag: sender.pay_tag,
      senderWallet: sender.addresses ? (sender.addresses.base || sender.addresses.celo) : sender.wallet_address,
      command: cmd,
      originalText,
    },
    status: 'pending',
    source_author_id: String(msg.from.id),
    source_author_username: msg.from.username || msg.from.first_name,
    source_tweet_id: String(msg.message_id),
  }).select().maybeSingle();

  if (error) console.error('❌ Failed to schedule:', error.message);

  const timeDesc = scheduleResult.timeDescription || scheduledAt.toUTCString();

  // Format the command for display - strip scheduling keywords so it looks clean
  const displayCommand = cleanCommand
    .replace(/^\/(?:send|pay|monibot)\s*/i, '')
    .trim();

  let summary = `⏰ *Command Scheduled!*\n\n📋 *Command:* ${displayCommand}\n🕐 *When:* ${timeDesc}\n✅ *Status:* ${job ? 'Queued' : 'Failed to queue'}\n\n_Job ID: ${job?.id || 'N/A'}_`;

  await bot.sendMessage(msg.chat.id, summary, { parse_mode: 'Markdown' });
}

// Expose the function globally for use by chat handler
global.handleScheduledCommandTg = handleScheduledCommandTg;

// ============ Auto-Restart ============

// Auto-restart removed — Railway handles container restarts via restart policy
process.on('SIGTERM', () => { bot.stopPolling(); process.exit(0); });
process.on('SIGINT', () => { bot.stopPolling(); process.exit(0); });
