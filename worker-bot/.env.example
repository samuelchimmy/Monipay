# ============ Twitter (Worker Bot — Silent Ops) ============
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_secret_here

# The bot's numeric Twitter ID (Essential for MagicPay logic)
# Find it at https://tweeterid.com by entering your bot's username
MONIBOT_USER_ID=1920804595963703296

# ============ Gemini AI (Evaluation Brain) ============
GEMINI_API_KEY=your_gemini_key_here

# ============ MoniBot Executor Wallet ============
# The private key of the wallet authorized as an EXECUTOR on the Router contract
MONIBOT_PRIVATE_KEY=0x...
# The UUID from your Supabase 'profiles' table for the bot itself
MONIBOT_PROFILE_ID=0cb9ca32-7ef2-4ced-8389-9dbca5156c94
# The bot's public wallet address
MONIBOT_WALLET_ADDRESS=0xdFA5fE220cE7C4BCBb1180686666b803DfAE8ED3

# ============ Supabase ============
SUPABASE_URL=https://vdaeojxonqmzejwiioaq.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ============ RPC URLs (Multi-Chain Support) ============
# Providing these overrides the defaults in chains.js
BASE_RPC_URL=https://mainnet.base.org
BSC_RPC_URL=https://bsc-dataseed.binance.org
CELO_RPC_URL=https://forno.celo.org
INK_RPC_URL=https://rpc-qnd.inkonchain.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

